{"data":{"diff_size":1,"new_content":"import edu.princeton.cs.algs4.WeightedQuickUnionUF;\r\n\r\npublic class Percolation {\r\n    int N;\r\n    int [] grid;\r\n    WeightedQuickUnionUF uf;\r\n\r\n    public Percolation(int N) {\r\n        if (N <= 0) {\r\n            throw new IllegalArgumentException();\r\n        }\r\n        this.N = N;\r\n        grid = new int[N*N];\r\n        uf = new WeightedQuickUnionUF(N*N);\r\n    }\r\n\r\n    public void open(int row, int col) {\r\n        if (stateOf(row, col) == 0) {\r\n            grid[row * N + col] = 1;\r\n        }\r\n    }\r\n\r\n    public boolean isOpen(int row, int col) {\r\n        return stateOf(row, col) > 0;\r\n    }\r\n\r\n    public boolean isFull(int row, int col) {\r\n        return stateOf(row, col) == 2;\r\n    }\r\n\r\n    public int numberOfOpenSites() {\r\n        // TODO: Fill in this method.\r\n        return 0;\r\n    }\r\n\r\n    public boolean percolates() {\r\n        // TODO: Fill in this method.\r\n        return false;\r\n    }\r\n\r\n    // TODO: Add any useful helper methods (we highly recommend this!).\r\n    // TODO: Remove all TODO comments before submitting.\r\n    public int stateOf(int row, int col) {\r\n        if (row < N || row >= 0 || col < N || col >= 0) {\r\n            return grid[row * N + col];\r\n        }\r\n        throw new java.lang.IndexOutOfBoundsException(\"Index: \" + row + \", \" + col);\r\n    }\r\n\r\n}\r\n","new_content_size":1293,"new_hash":"511b05c8f9b34d44d39955a8a1dec1d93f46344cd901f44760cde2b97e0c3e4e","old_hash":"e22f2e85b695d2d856517195abb205367923f82fa99358f58ac7a7b3e56969e3","operation":"modify","path":"src/Percolation.java"},"hash":"db8bf8fb08db90fb0f5d7bbca2420fd165ee1640a1b1150409997318cfac5157","kind":"fs.external_change","prev_hash":"f10b0604bf0d1084dbbdcfe7f7e6e5c00e26605195bc5283ee0c6c6ecda2e43c","seq":356,"t":4738671,"wall":"2026-10-22T06:57:23.197Z"}
