{"data":{"diff_size":3,"new_content":"import edu.princeton.cs.algs4.WeightedQuickUnionUF;\r\n\r\npublic class Percolation {\r\n    int N;\r\n    int [] grid;\r\n    WeightedQuickUnionUF uf;\r\n\r\n    public Percolation(int N) {\r\n        if (N <= 0) {\r\n            throw new IllegalArgumentException();\r\n        }\r\n        this.N = N;\r\n        grid = new int[N*N];\r\n        uf = new WeightedQuickUnionUF(N*N);\r\n    }\r\n\r\n    public void open(int row, int col) {\r\n        if (stateOf(row, col) == 0) {\r\n            grid[row * N + col] = 1;\r\n            if (row > 0 || stateOf(row - 1, col) == 1) {\r\n                uf.union(row * N + col, 1);\r\n            }\r\n            if (row < N) {\r\n                result[1] = stateOf(row + 1, col);\r\n            }\r\n            if (col > 0) {\r\n                result[2] = stateOf(row, col - 1);\r\n            }\r\n            if (col < N) {\r\n                result[3] = stateOf(row, col + 1);\r\n            }\r\n        }\r\n    }\r\n\r\n    public boolean isOpen(int row, int col) {\r\n        return stateOf(row, col) > 0;\r\n    }\r\n\r\n    public boolean isFull(int row, int col) {\r\n        return stateOf(row, col) == 2;\r\n    }\r\n\r\n    public int numberOfOpenSites() {\r\n        // TODO: Fill in this method.\r\n        return 0;\r\n    }\r\n\r\n    public boolean percolates() {\r\n        // TODO: Fill in this method.\r\n        return false;\r\n    }\r\n\r\n    // TODO: Add any useful helper methods (we highly recommend this!).\r\n    // TODO: Remove all TODO comments before submitting.\r\n    public int stateOf(int row, int col) {\r\n        return grid[idx(row, col)];\r\n    }\r\n\r\n    public int idx(int row, int col) {\r\n        if (row < N || row >= 0 || col < N || col >= 0) {\r\n            return row * N + col;\r\n        }\r\n        throw new java.lang.IndexOutOfBoundsException(\"Index: \" + row + \", \" + col);\r\n    }\r\n\r\n    public static void main(String[] args) {\r\n\r\n    }\r\n\r\n}\r\n","new_content_size":1833,"new_hash":"56c74012013829a10150f46f98c42c1869f1bcb2b0427d36395e4d728653364a","old_hash":"d41833d28f4e9f70ae5646500205f51d33f3cf63bfc586acd102db1faa440fae","operation":"modify","path":"src/Percolation.java"},"hash":"7ff7a2256d3c83b6f4e93b0966d919db2249e1c3d669591525e152462a75b4c3","kind":"fs.external_change","prev_hash":"75645b9d60d33d03fd7e4f6a0ecf80753b941388f949d3126228b2f3945f2da1","seq":715,"t":10784228,"wall":"2026-10-22T08:38:08.600Z"}
