{"data":{"diff_size":0,"new_content":"import edu.princeton.cs.algs4.WeightedQuickUnionUF;\r\n\r\npublic class Percolation {\r\n    int N;\r\n    int [] grid;\r\n    WeightedQuickUnionUF uf;\r\n\r\n    public Percolation(int N) {\r\n        if (N <= 0) {\r\n            throw new IllegalArgumentException();\r\n        }\r\n        this.N = N;\r\n        grid = new int[N*N];\r\n        uf = new WeightedQuickUnionUF(N*N);\r\n    }\r\n\r\n    public void open(int row, int col) {\r\n        if (stateOf(row, col) == 0) {\r\n            grid[row * N + col] = 1;\r\n            for (int stat : adjacent(row, col)) {\r\n\r\n            }\r\n        }\r\n    }\r\n\r\n    public boolean isOpen(int row, int col) {\r\n        return stateOf(row, col) > 0;\r\n    }\r\n\r\n    public boolean isFull(int row, int col) {\r\n        return stateOf(row, col) == 2;\r\n    }\r\n\r\n    public int numberOfOpenSites() {\r\n        // TODO: Fill in this method.\r\n        return 0;\r\n    }\r\n\r\n    public boolean percolates() {\r\n        // TODO: Fill in this method.\r\n        return false;\r\n    }\r\n\r\n    // TODO: Add any useful helper methods (we highly recommend this!).\r\n    // TODO: Remove all TODO comments before submitting.\r\n    public int stateOf(int row, int col) {\r\n        if (row < N || row >= 0 || col < N || col >= 0) {\r\n            return grid[row * N + col];\r\n        }\r\n        throw new java.lang.IndexOutOfBoundsException(\"Index: \" + row + \", \" + col);\r\n    }\r\n\r\n    public int[] adjacent(int row, int col) {\r\n        int [] result = new int[4];\r\n        if (row < N || row >= 0 || col < N || col >= 0) {\r\n            if (row > 0) {\r\n                result[0] = stateOf(row - 1, col);\r\n            }\r\n            if (row < N) {\r\n                result[1] = stateOf(row + 1, col);\r\n            }\r\n            if (col > 0) {\r\n                result[2] = stateOf(row, col - 1);\r\n            }\r\n            if (col < N) {\r\n                result[3] = stateOf(row, col + 1);\r\n            }\r\n            return result;\r\n        }\r\n        throw new java.lang.IndexOutOfBoundsException(\"Index: \" + row + \", \" + col);\r\n    }\r\n\r\n}\r\n","new_content_size":2018,"new_hash":"f7cdca15fdb2ec3d05c7fa69a959916e262f2377e1954a00c29d40156bfc2f96","old_hash":"7f34c58efce6104fbadc72708bd6188e880f33eba45ac5f237f7636e771c52e7","operation":"modify","path":"src/Percolation.java"},"hash":"a851f4b9e4247e92e765d4fe886ff8e52961ae0191a07bfaef1f95c45ffebce2","kind":"fs.external_change","prev_hash":"348263527780ee934c538d8ff0b61b3d0603fabf6824f7b824406d8f8fee9035","seq":617,"t":9159282,"wall":"2026-10-22T08:11:03.653Z"}
