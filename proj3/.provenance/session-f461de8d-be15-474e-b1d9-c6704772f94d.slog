{"data":{"diff_size":0,"new_content":"import edu.princeton.cs.algs4.WeightedQuickUnionUF;\r\n\r\npublic class Percolation {\r\n    int N;\r\n    int [] grid;\r\n    WeightedQuickUnionUF uf;\r\n\r\n    public Percolation(int N) {\r\n        if (N <= 0) {\r\n            throw new IllegalArgumentException();\r\n        }\r\n        this.N = N;\r\n        grid = new int[N*N];\r\n        uf = new WeightedQuickUnionUF(N*N);\r\n    }\r\n\r\n    public void open(int row, int col) {\r\n        if (stateOf(row, col) == 0) {\r\n            grid[row * N + col] = 1;\r\n            if (row > 0 || stateOf(row - 1, col) == 1) {\r\n                uf.union(idx(row, col), idx(row - 1, col));\r\n            }\r\n            if (row < N - 1 || stateOf(row + 1, col) == 1) {\r\n                uf.union(idx(row, col), idx(row + 1, col));\r\n            }\r\n            if (col > 0  || stateOf(row, col - 1) == 1) {\r\n                uf.union(idx(row, col), idx(row, col - 1));\r\n            }\r\n            if (col < N  - 1 || stateOf(row, col + 1) == 1) {\r\n                uf.union(idx(row, col), idx(row, col + 1));\r\n            }\r\n        }\r\n    }\r\n\r\n    public boolean isOpen(int row, int col) {\r\n        return stateOf(row, col) > 0;\r\n    }\r\n\r\n    public boolean isFull(int row, int col) {\r\n        return stateOf(row, col) == 2;\r\n    }\r\n\r\n    public int numberOfOpenSites() {\r\n        // TODO: Fill in this method.\r\n        return 0;\r\n    }\r\n\r\n    public boolean percolates() {\r\n        // TODO: Fill in this method.\r\n        return false;\r\n    }\r\n\r\n    // TODO: Add any useful helper methods (we highly recommend this!).\r\n    // TODO: Remove all TODO comments before submitting.\r\n    public int stateOf(int row, int col) {\r\n        return grid[idx(row, col)];\r\n    }\r\n\r\n    public int idx(int row, int col) {\r\n        if (row < N || row >= 0 || col < N || col >= 0) {\r\n            return row * N + col;\r\n        }\r\n        throw new java.lang.IndexOutOfBoundsException(\"Index: \" + row + \", \" + col);\r\n    }\r\n\r\n    public static void main(String[] args) {\r\n\r\n    }\r\n\r\n}\r\n","new_content_size":1976,"new_hash":"6a31c13b18dae481098c46d5c4f24130dd0824ce61966cc5461aa90aa86cf847","old_hash":"4973b39f7f566264d28a5e2fd0d5be34c39ef24465b1e5f2c50f05096739af3b","operation":"modify","path":"src/Percolation.java"},"hash":"40cb8927ba1e5d80101f370cd9365e6ffdc5553731a6ce181b41c4c6c30b878d","kind":"fs.external_change","prev_hash":"9bf44f476c19e44fa3c864f75f4b9799db7814ff04636f853e7b92b6032ba9d4","seq":761,"t":10868112,"wall":"2026-10-22T08:39:32.483Z"}
