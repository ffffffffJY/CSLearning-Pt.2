{"data":{"diff_size":3,"new_content":"import edu.princeton.cs.algs4.WeightedQuickUnionUF;\r\n\r\npublic class Percolation {\r\n    int N;\r\n    int [] grid;\r\n    WeightedQuickUnionUF uf;\r\n\r\n    public Percolation(int N) {\r\n        if (N <= 0) {\r\n            throw new IllegalArgumentException();\r\n        }\r\n        this.N = N;\r\n        grid = new int[N*N];\r\n        uf = new WeightedQuickUnionUF(N*N);\r\n    }\r\n\r\n    public void open(int row, int col) {\r\n        if (row < N || row >= 0 || col < N || col >= 0) {\r\n            \r\n        }\r\n        throw new java.lang.IndexOutOfBoundsException(\"Index: \" + row + \", \" + col);\r\n    }\r\n\r\n    public boolean isOpen(int row, int col) {\r\n        if (row < N || row >= 0 || col < N || col >= 0) {\r\n            if (grid[row * N + col] == 1) {\r\n                return true;\r\n            }\r\n            return false;\r\n        }\r\n        throw new java.lang.IndexOutOfBoundsException(\"Index: \" + row + \", \" + col);\r\n    }\r\n\r\n    public boolean isFull(int row, int col) {\r\n        // TODO: Fill in this method.\r\n        return false;\r\n    }\r\n\r\n    public int numberOfOpenSites() {\r\n        // TODO: Fill in this method.\r\n        return 0;\r\n    }\r\n\r\n    public boolean percolates() {\r\n        // TODO: Fill in this method.\r\n        return false;\r\n    }\r\n\r\n    // TODO: Add any useful helper methods (we highly recommend this!).\r\n    // TODO: Remove all TODO comments before submitting.\r\n\r\n}\r\n","new_content_size":1383,"new_hash":"9a536d7b99ac0b0c6452166afcab7b9e9e639315fde6c4dc3b219b422e9dc7ca","old_hash":"3c63b840c9c9a76c61a7db5cbc539e9cfc99667c63bc0e97539ddcf668283a89","operation":"modify","path":"src/Percolation.java"},"hash":"6122bb91f0c4ae084c9fd9a9bc44197827300b923be6ac06a1f755818db2cc12","kind":"fs.external_change","prev_hash":"6e9eda59e9dd1b80992fb525a8c6f521a47d01076f9ce248b3665ff1a2881483","seq":236,"t":4054742,"wall":"2026-10-22T06:45:59.26