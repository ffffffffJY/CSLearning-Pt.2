{"data":{"diff_size":0,"new_content":"import edu.princeton.cs.algs4.WeightedQuickUnionUF;\r\n\r\npublic class Percolation {\r\n    int N;\r\n    int [] grid;\r\n    WeightedQuickUnionUF uf;\r\n    int opened;\r\n\r\n    public Percolation(int N) {\r\n        if (N <= 0) {\r\n            throw new IllegalArgumentException();\r\n        }\r\n        this.N = N;\r\n        grid = new int[N*N];\r\n        uf = new WeightedQuickUnionUF(N*N);\r\n        opened = 0;\r\n        for (int i = 1; i < N; i++) {\r\n            uf.union(0, i);\r\n            uf.union(N*(N-1), N*(N-1) + i);\r\n        }\r\n    }\r\n\r\n    public void open(int row, int col) {\r\n        if (stateOf(row, col) == 0) {\r\n            grid[row * N + col] = 1;\r\n            opened++;\r\n            if (row > 0 && stateOf(row - 1, col) == 1) {\r\n                uf.union(idx(row, col), idx(row - 1, col));\r\n            }\r\n            if (row < N - 1 && stateOf(row + 1, col) == 1) {\r\n                uf.union(idx(row, col), idx(row + 1, col));\r\n            }\r\n            if (col > 0 && stateOf(row, col - 1) == 1) {\r\n                uf.union(idx(row, col), idx(row, col - 1));\r\n            }\r\n            if (col < N - 1 && stateOf(row, col + 1) == 1) {\r\n                uf.union(idx(row, col), idx(row, col + 1));\r\n            }\r\n        }\r\n    }\r\n\r\n    public boolean isOpen(int row, int col) {\r\n        return stateOf(row, col) == 1;\r\n    }\r\n\r\n    public boolean isFull(int row, int col) {\r\n        if (stateOf(row, col) == 0) {\r\n            return false;\r\n        }\r\n        return uf.connected(0, idx(row, col));\r\n    }\r\n\r\n    public int numberOfOpenSites() {\r\n        return opened;\r\n    }\r\n\r\n    public boolean percolates() {\r\n        // TODO: Fill in this method.\r\n        return uf.connected(0, N*(N-1));\r\n    }\r\n\r\n    // TODO: Add any useful helper methods (we highly recommend this!).\r\n    // TODO: Remove all TODO comments before submitting.\r\n    public int stateOf(int row, int col) {\r\n        return grid[idx(row, col)];\r\n    }\r\n\r\n    public int idx(int row, int col) {\r\n        if (row < N && row >= 0 && col < N && col >= 0) {\r\n            return row * N + col;\r\n        }\r\n        throw new java.lang.IndexOutOfBoundsException(\"Index: \" + row + \", \" + col);\r\n    }\r\n\r\n    public static void main(String[] args) {\r\n\r\n    }\r\n\r\n}\r\n","new_content_size":2230,"new_hash":"1de161978f64686bcd354f651e24115a81c0077f4a61181000f26e991682b3de","old_hash":"56e166254f50b96e906db82100fc04b0062fe5d02167f136d909fe678fa6f3cb","operation":"modify","path":"src/Percolation.java"},"hash":"12d82f3616729f0ae7fc50ed804b09d006dee6573dfa0e18ffc54c4523f2733c","kind":"fs.external_change","prev_hash":"ef4d76e4b1fb20d6b91dee5766cba1ffda9a82c03750a8588bca03a86cec35ea","seq":34,"t":419987,"wall":"2026-10-23T14:06:22.709Z"}
