{"data":{"diff_size":0,"new_content":"import edu.princeton.cs.algs4.WeightedQuickUnionUF;\r\n\r\npublic class Percolation {\r\n    int N;\r\n    int [] grid;\r\n    WeightedQuickUnionUF uf;\r\n    int opened;\r\n    boolean isPercolated;\r\n\r\n    public Percolation(int N) {\r\n        if (N <= 0) {\r\n            throw new IllegalArgumentException();\r\n        }\r\n        this.N = N;\r\n        grid = new int[N*N];\r\n        uf = new WeightedQuickUnionUF(N*N);\r\n        opened = 0;\r\n        for (int i = 1; i < N; i++) {\r\n            uf.union(0, i);\r\n        }\r\n    }\r\n\r\n    public void open(int row, int col) {\r\n        if (stateOf(row, col) == 0) {\r\n            grid[row * N + col] = 1;\r\n            opened++;\r\n            if (row > 0 && stateOf(row - 1, col) == 1) {\r\n                uf.union(idx(row, col), idx(row - 1, col));\r\n            }\r\n            if (row < N - 1 && stateOf(row + 1, col) == 1) {\r\n                uf.union(idx(row, col), idx(row + 1, col));\r\n            }\r\n            if (col > 0 && stateOf(row, col - 1) == 1) {\r\n                uf.union(idx(row, col), idx(row, col - 1));\r\n            }\r\n            if (col < N - 1 && stateOf(row, col + 1) == 1) {\r\n                uf.union(idx(row, col), idx(row, col + 1));\r\n            }\r\n        }\r\n    }\r\n\r\n    public boolean isOpen(int row, int col) {\r\n        return stateOf(row, col) == 1;\r\n    }\r\n\r\n    public boolean isFull(int row, int col) {\r\n        if (stateOf(row, col) == 0) {\r\n            return false;\r\n        }\r\n        return uf.connected(0, idx(row, col));\r\n    }\r\n\r\n    public int numberOfOpenSites() {\r\n        return opened;\r\n    }\r\n\r\n    public boolean percolates() {\r\n        return isPercolated;\r\n    }\r\n\r\n\r\n    public int stateOf(int row, int col) {\r\n        return grid[idx(row, col)];\r\n    }\r\n\r\n    public int idx(int row, int col) {\r\n        if (row < N && row >= 0 && col < N && col >= 0) {\r\n            return row * N + col;\r\n        }\r\n        throw new java.lang.IndexOutOfBoundsException(\"Index: \" + row + \", \" + col);\r\n    }\r\n\r\n    public static void main(String[] args) {\r\n\r\n    }\r\n\r\n}\r\n","new_content_size":2032,"new_hash":"72f63722eb5fb2c0246bf6351d7b7b90f7e80dd455770a40c0fc6d930de74733","old_hash":"3cca2426854f03728e6802a305ec0da9307401dec545f2bf23dc51feb30af3a4","operation":"modify","path":"src/Percolation.java"},"hash":"096b0648e0b2735118341067a9f677093eaf41da94fdc6ed7d8f4385cebac2a6","kind":"fs.external_change","prev_hash":"c6f197ba2c4813d2cf7dd55612f9a4b9c916cf5a57674293198e8dab2eaffdda","seq":344,"t":2116095,"wall":"2026-10-24T07:03:06.152Z"}
