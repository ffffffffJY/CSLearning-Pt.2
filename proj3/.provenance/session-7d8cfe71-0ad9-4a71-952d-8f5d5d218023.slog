{"data":{"diff_size":3,"new_content":"import edu.princeton.cs.algs4.WeightedQuickUnionUF;\r\n\r\npublic class Percolation {\r\n    int N;\r\n    int [] grid;\r\n    WeightedQuickUnionUF uf;\r\n    int opened;\r\n    boolean isPercolated;\r\n\r\n    public Percolation(int N) {\r\n        if (N <= 0) {\r\n            throw new IllegalArgumentException();\r\n        }\r\n        this.N = N;\r\n        grid = new int[N*N];\r\n        uf = new WeightedQuickUnionUF(N*N);\r\n        opened = 0;\r\n        for (int i = 1; i < N; i++) {\r\n            uf.union(0, i);\r\n        }\r\n    }\r\n\r\n    public void open(int row, int col) {\r\n        if (stateOf(row, col) == 0) {\r\n            grid[row * N + col] = 1;\r\n            opened++;\r\n            if (row > 0 && stateOf(row - 1, col) == 1) {\r\n                uf.union(idx(row, col), idx(row - 1, col));\r\n            }\r\n            if (row < N - 1 && stateOf(row + 1, col) == 1) {\r\n                uf.union(idx(row, col), idx(row + 1, col));\r\n            }\r\n            if (col > 0 && stateOf(row, col - 1) == 1) {\r\n                uf.union(idx(row, col), idx(row, col - 1));\r\n            }\r\n            if (col < N - 1 && stateOf(row, col + 1) == 1) {\r\n                uf.union(idx(row, col), idx(row, col + 1));\r\n            }\r\n        }\r\n    }\r\n\r\n    public boolean isOpen(int row, int col) {\r\n        return stateOf(row, col) == 1;\r\n    }\r\n\r\n    public boolean isFull(int row, int col) {\r\n        if (stateOf(row, col) == 0) {\r\n            return false;\r\n        }\r\n        if (row == N - 1 && uf.connected(0, idx(row, col))) {\r\n            isPercolated = true;\r\n        }\r\n        return uf.connected(0, idx(row, col));\r\n    }\r\n\r\n    public int numberOfOpenSites() {\r\n        return opened;\r\n    }\r\n\r\n    public boolean percolates() {\r\n        return isPercolated;\r\n    }\r\n\r\n\r\n    public int stateOf(int row, int col) {\r\n        return grid[idx(row, col)];\r\n    }\r\n\r\n    public int idx(int row, int col) {\r\n        if (row < N && row >= 0 && col < N && col >= 0) {\r\n            return row * N + col;\r\n        }\r\n        throw new java.lang.IndexOutOfBoundsException(\"Index: \" + row + \", \" + col);\r\n    }\r\n\r\n    public static void main(String[] args) {\r\n\r\n    }\r\n\r\n}\r\n","new_content_size":2140,"new_hash":"6410921f47fa716ccadd5f132341cd679aee6560e37e933f82de1f3642390923","old_hash":"adfa5f70c25086c83d2f6c180c660d149ac5065f41f5f73f448f2299dafa7909","operation":"modify","path":"src/Percolation.java"},"hash":"1a2d1e4a57334984db16f9be8f80c9b79fc77765d38cbcdc3e8677c6f433bad2","kind":"fs.external_change","prev_hash":"c60e64de4856e506c576abbe09efab22d1b34bf52e823e5831d04f7b4377f256","seq":370,"t":2189062,"wall":"2026-10-24T07:04:19.119Z"}
