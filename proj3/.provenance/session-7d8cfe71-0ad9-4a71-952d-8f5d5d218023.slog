{"data":{"diff_size":1,"new_content":"import edu.princeton.cs.algs4.WeightedQuickUnionUF;\r\n\r\npublic class Percolation {\r\n    int N;\r\n    int [] grid;\r\n    WeightedQuickUnionUF uf;\r\n    int opened;\r\n\r\n    public Percolation(int N) {\r\n        if (N <= 0) {\r\n            throw new IllegalArgumentException();\r\n        }\r\n        this.N = N;\r\n        grid = new int[N*N];\r\n        uf = new WeightedQuickUnionUF(N*N);\r\n        opened = 0;\r\n        for (int i = 1; i < N; i++) {\r\n            uf.union(0, i);\r\n        }\r\n    }\r\n\r\n    public void open(int row, int col) {\r\n        if (stateOf(row, col) == 0) {\r\n            grid[row * N + col] = 1;\r\n            opened++;\r\n            if (row > 0 && stateOf(row - 1, col) == 1) {\r\n                uf.union(idx(row, col), idx(row - 1, col));\r\n            }\r\n            if (row < N - 1 && stateOf(row + 1, col) == 1) {\r\n                uf.union(idx(row, col), idx(row + 1, col));\r\n            }\r\n            if (col > 0 && stateOf(row, col - 1) == 1) {\r\n                uf.union(idx(row, col), idx(row, col - 1));\r\n            }\r\n            if (col < N - 1 && stateOf(row, col + 1) == 1) {\r\n                uf.union(idx(row, col), idx(row, col + 1));\r\n            }\r\n        }\r\n    }\r\n\r\n    public boolean isOpen(int row, int col) {\r\n        return stateOf(row, col) == 1;\r\n    }\r\n\r\n    public boolean isFull(int row, int col) {\r\n        if (stateOf(row, col) == 0) {\r\n            return false;\r\n        }\r\n        return uf.connected(0, idx(row, col));\r\n    }\r\n\r\n    public int numberOfOpenSites() {\r\n        return opened;\r\n    }\r\n\r\n    public boolean percolates() {\r\n        // TODO: Fill in this method.\r\n        return uf.connected(0, N*(N-1));\r\n    }\r\n\r\n\r\n    public int stateOf(int row, int col) {\r\n        return grid[idx(row, col)];\r\n    }\r\n\r\n    public int idx(int row, int col) {\r\n        if (row < N && row >= 0 && col < N && col >= 0) {\r\n            return row * N + col;\r\n        }\r\n        throw new java.lang.IndexOutOfBoundsException(\"Index: \" + row + \", \" + col);\r\n    }\r\n\r\n    public static void main(String[] args) {\r\n\r\n    }\r\n\r\n}\r\n","new_content_size":2056,"new_hash":"ed19e5a8089836b4d6059d0a2c24aea62719c89e68fdfad82837e1ca7b10c846","old_hash":"cffa90646f787df35f9a45bbf9bebdefcfdb2d3244deb563d2a1896aff1c9eb0","operation":"modify","path":"src/Percolation.java"},"hash":"ab446cc6c4c2c839d1ecb119fc8331f05682dfee36ebf193802c2a1a4fd4aa75","kind":"fs.external_change","prev_hash":"b8425c88a22229b187cee38924226ec049ee856183528149e78d4e80134ff391","seq":310,"t":2077965,"wall":"2026-10-24T07:02:28.020Z"}
