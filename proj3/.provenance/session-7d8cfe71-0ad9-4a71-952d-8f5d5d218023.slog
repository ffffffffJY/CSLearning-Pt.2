{"data":{"diff_size":29,"new_content":"import org.junit.jupiter.api.Test;\r\n\r\nimport static com.google.common.truth.Truth.assertThat;\r\nimport static org.junit.jupiter.api.Assertions.assertThrows;\r\nimport static org.junit.jupiter.api.Assertions.fail;\r\n\r\npublic class PercolationTest {\r\n\r\n    /**\r\n     * Enum to represent the state of a cell in the grid. Use this enum to help you write tests.\r\n     * <p>\r\n     * (0) CLOSED: isOpen() returns true, isFull() return false\r\n     * <p>\r\n     * (1) OPEN: isOpen() returns true, isFull() returns false\r\n     * <p>\r\n     * (2) INVALID: isOpen() returns false, isFull() returns true\r\n     *              (This should not happen! Only open cells should be full.)\r\n     * <p>\r\n     * (3) FULL: isOpen() returns true, isFull() returns true\r\n     * <p>\r\n     */\r\n    private enum Cell {\r\n        CLOSED, OPEN, INVALID, FULL\r\n    }\r\n\r\n    /**\r\n     * Creates a Cell[][] based off of what Percolation p returns.\r\n     * Use this method in your tests to see if isOpen and isFull are returning the\r\n     * correct things.\r\n     */\r\n    private static Cell[][] getState(int N, Percolation p) {\r\n        Cell[][] state = new Cell[N][N];\r\n        for (int r = 0; r < N; r++) {\r\n            for (int c = 0; c < N; c++) {\r\n                int open = p.isOpen(r, c) ? 1 : 0;\r\n                int full = p.isFull(r, c) ? 2 : 0;\r\n                state[r][c] = Cell.values()[open + full];\r\n            }\r\n        }\r\n        return state;\r\n    }\r\n\r\n    @Test\r\n    public void basicTest() {\r\n        int N = 5;\r\n        Percolation p = new Percolation(N);\r\n        // open sites at (r, c) = (0, 1), (2, 0), (3, 1), etc. (0, 0) is top-left\r\n        int[][] openSites = {\r\n                {0, 1},\r\n                {2, 0},\r\n                {3, 1},\r\n                {4, 1},\r\n                {1, 0},\r\n                {1, 1}\r\n        };\r\n        Cell[][] expectedState = {\r\n                {Cell.CLOSED, Cell.FULL, Cell.CLOSED, Cell.CLOSED, Cell.CLOSED},\r\n                {Cell.FULL, Cell.FULL, Cell.CLOSED, Cell.CLOSED, Cell.CLOSED},\r\n                {Cell.FULL, Cell.CLOSED, Cell.CLOSED, Cell.CLOSED, Cell.CLOSED},\r\n                {Cell.CLOSED, Cell.OPEN, Cell.CLOSED, Cell.CLOSED, Cell.CLOSED},\r\n                {Cell.CLOSED, Cell.OPEN, Cell.CLOSED, Cell.CLOSED, Cell.CLOSED}\r\n        };\r\n        for (int[] site : openSites) {\r\n            p.open(site[0], site[1]);\r\n        }\r\n        assertThat(getState(N, p)).isEqualTo(expectedState);\r\n        assertThat(p.percolates()).isFalse();\r\n    }\r\n\r\n    @Test\r\n    public void oneByOneTest() {\r\n        int N = 1;\r\n        Percolation p = new Percolation(N);\r\n        p.open(0, 0);\r\n        Cell[][] expectedState = {\r\n                {Cell.FULL}\r\n        };\r\n        assertThat(getState(N, p)).isEqualTo(expectedState);\r\n        assertThat(p.percolates()).isTrue();\r\n    }\r\n\r\n    @Test\r\n    public void boundaryTest() {\r\n        int N = 5;\r\n        assertThrows(IllegalArgumentException.class, () -> new Percolation(-1));\r\n        Percolation p = new Percolation(N);\r\n        int[][] openSites = {\r\n                {0, 5},\r\n                {-1, 0},\r\n                {3, -1},\r\n                {5, 1},\r\n                {6, 0},\r\n        };\r\n        for (int[] site : openSites) {\r\n            assertThrows(IndexOutOfBoundsException.class, () -> p.open(site[0], site[1]));\r\n        }\r\n\r\n        Cell[][] expectedState = {\r\n                {Cell.CLOSED, Cell.CLOSED, Cell.CLOSED, Cell.CLOSED, Cell.CLOSED},\r\n                {Cell.CLOSED, Cell.CLOSED, Cell.CLOSED, Cell.CLOSED, Cell.CLOSED},\r\n                {Cell.CLOSED, Cell.CLOSED, Cell.CLOSED, Cell.CLOSED, Cell.CLOSED},\r\n                {Cell.CLOSED, Cell.CLOSED, Cell.CLOSED, Cell.CLOSED, Cell.CLOSED},\r\n                {Cell.CLOSED, Cell.CLOSED, Cell.CLOSED, Cell.CLOSED, Cell.CLOSED}\r\n        };\r\n        assertThat(getState(N, p)).isEqualTo(expectedState);\r\n    }\r\n\r\n    @Test\r\n    public void backwashTest() {\r\n        int N = 5;\r\n        Percolation p = new Percolation(N);\r\n        int[][] openSites = {\r\n                {0, 2},\r\n                {2, 1},\r\n                {3, 2},\r\n                {4, 2},\r\n                {1, 1},\r\n                {1, 2},\r\n                {3, 1},\r\n                {4, 4},\r\n                {3, 4},\r\n        };\r\n        Cell[][] expectedState = {\r\n                {Cell.CLOSED, Cell.CLOSED, Cell.FULL, Cell.CLOSED, Cell.CLOSED},\r\n                {Cell.CLOSED, Cell.FULL, Cell.FULL, Cell.CLOSED, Cell.CLOSED},\r\n                {Cell.CLOSED, Cell.FULL, Cell.CLOSED, Cell.CLOSED, Cell.CLOSED},\r\n                {Cell.CLOSED, Cell.FULL, Cell.FULL, Cell.CLOSED, Cell.OPEN},\r\n                {Cell.CLOSED, Cell.CLOSED, Cell.FULL, Cell.CLOSED, Cell.OPEN}\r\n        };\r\n        for (int[] site : openSites) {\r\n            p.open(site[0], site[1]);\r\n        }\r\n        assertThat(getState(N, p)).isEqualTo(expectedState);\r\n        assertThat(p.percolates()).isFalse();\r\n    }\r\n\r\n}\r\n","new_content_size":4888,"new_hash":"7689968c4897827fe6f8db37053cba351d7be3eae313d67d87b8d44985edbe8a","old_hash":"9b8983d267f600b14ee0c65e8c02d819e341881e0a6bdad7ff2659a7a2e42bbb","operation":"modify","path":"tests/PercolationTest.java"},"hash":"1256a1870bc5bad7684b612ed180f09804262d126891eade12a7e2ad44713634","kind":"fs.external_change","prev_hash":"6b5cce76b7e62508ec1a41d6a5aa3cf7aa314afdb58e5ec31b9ea6fd4dc4f662","seq":293,"t":1646582,"wall":"2026-10-24T06:55:16.638Z"}
