{"data":{"content":"import org.junit.jupiter.api.DisplayName;\nimport org.junit.jupiter.api.MethodOrderer;\nimport org.junit.jupiter.api.Order;\nimport org.junit.jupiter.api.Test;\nimport org.junit.jupiter.api.TestMethodOrder;\n\nimport java.util.Arrays;\n\nimport static com.google.common.truth.Truth.assertThat;\nimport static org.junit.Assert.fail;\n\n@TestMethodOrder(MethodOrderer.OrderAnnotation.class)\npublic class IntListOptionalTests {\n    // TBD\n}\n","line_count":16,"path":"tests/IntListOptionalTests.java","sha256":"c306f096ca7addf92926aca84692506f09adae4a65ab05a23aee2b4c4d2cc3e5"},"hash":"9f5b789bf171bfe73dcc6aaababce05b0f9184051848eff44efc5c4c452c7357","kind":"doc.open","prev_hash":"dc588532d6150a285c20c1043391a4a23bc4ba490e167d4fb98777efe8c5ffe9","seq":9,"t":27037,"wall":"2026-09-24T06:17:05.132Z"}
