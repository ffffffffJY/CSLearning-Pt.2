{"data":{"diff_size":82,"new_content":"public class IntList {\r\n    int first;\r\n    IntList rest;\r\n\r\n    public IntList(int f, IntList r) {\r\n        first = f;\r\n        rest = r;\r\n    }\r\n\r\n    /** Return the size of the list using... recursion! */\r\n    public int size() {\r\n        if (rest == null) {\r\n            return 1;\r\n        }\r\n        return 1 + this.rest.size();\r\n    }\r\n\r\n    /** Return the size of the list using no recursion! */\r\n    public int iterativeSize() {\r\n        IntList p = this;\r\n        int totalSize = 0;\r\n        while (p != null) {\r\n            totalSize += 1;\r\n            p = p.rest;\r\n        }\r\n        return totalSize;\r\n    }\r\n\r\n    /** Returns the ith item of this IntList. */\r\n    public int get(int i) {\r\n        if (i == 0) {\r\n            return first;\r\n        }\r\n        return rest.get(i - 1);\r\n    }\r\n\r\n    /**\r\n     * Returns an IntList identical to L, but with\r\n     * each element incremented by x. Modifies the original list.\r\n     * You are not allowed to use \"new\" in this method.\r\n     */\r\n    public static IntList incrRecursiveDestructive(IntList L, int x) {\r\n        // TODO: Fill in this code\r\n        IntList p = L;\r\n        while (p != null) {\r\n            p.first = p.first + x;\r\n            p = p.rest;\r\n        }\r\n        return L;\r\n    }\r\n\r\n    /*\r\n     * =================================================================\r\n     * OPTIONAL METHODS\r\n     * =================================================================\r\n     */\r\n\r\n    /**\r\n     * Returns the sum of all elements in the IntList.\r\n     */\r\n    public int sum() {\r\n        // Optional: Fill in this code\r\n        return 0;\r\n    }\r\n\r\n    /**\r\n     * Destructively adds x to the end of the list.\r\n     */\r\n    public void addLast(int x) {\r\n        // Optional: Fill in this code\r\n    }\r\n\r\n    /**\r\n     * Destructively adds x to the front of this IntList.\r\n     * This is a bit tricky to implement. The standard way to do this would be\r\n     * to return a new IntList, but for practice, this implementation should\r\n     * be destructive.\r\n     */\r\n    public void addFirst(int x) {\r\n        // Optional: Fill in this code\r\n    }\r\n}\r\n","new_content_size":2116,"new_hash":"7eabc741c326e84f37d7b5d423aae59efb5e2a72f8f8062a76b2ea2f54ad8a9c","old_hash":"65aada97fdc9bb75657774a0fbd8a34bb1023ad06a968a6886af25931c7f5098","operation":"modify","path":"src/IntList.java"},"hash":"8e03f0c431c08cc7dd8ee556696dde188927f2eb46163ce57d056c1d6e1d45b4","kind":"fs.external_change","prev_hash":"6fec30d10834bf039f925ac7157d6cd9e85b824408215571c8592035f03b5a85","seq":286,"t":4988013,"wall":"2026-09-25T05:52:41.090Z"}
