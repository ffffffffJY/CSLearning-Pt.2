{"data":{"content":"ArrayDequeIterator<T>() {\n            private int pos;\n\n            public Iterator() {\n                pos = 0;\n            }\n\n            @Override\n            public boolean hasNext() {\n                return pos < end;\n            }\n            @Override\n            public T next() {\n                T ret = array[pos];\n                pos = circ(pos + 1);\n                return ret;\n            }\n        }","length":413,"path":"src/ArrayDeque61B.java","range":{"end":{"character":8,"line":219},"start":{"character":8,"line":219}},"sha256":"0c2c25e28812f441a3357a1d34b81c14531c2d4e2dd3e2f22881daf14467bd2b"},"hash":"b02e5236cb2c09c3141ebb9e29be81bd96bed5a4dc0edb1aeca2a50494234822","kind":"paste","prev_hash":"e4da3f0605480f31b5eb146d7909391352455379e8dbe6e4821f73901aa9081a","seq":486,"t":24251790,"wall":"2026-10-14T14:17:50.148Z"}
