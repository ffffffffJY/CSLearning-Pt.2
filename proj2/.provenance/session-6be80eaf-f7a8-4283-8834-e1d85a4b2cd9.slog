{"data":{"diff_size":11,"new_content":"import org.junit.jupiter.api.Test;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\nimport static com.google.common.truth.Truth.assertThat;\r\n\r\npublic class ArrayDeque61BEnhancementTest {\r\n    @Test\r\n    public void testIterator() {\r\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\r\n        for (int i = 0; i < 8; i++) {\r\n            ad1.addFirst(i);\r\n        }\r\n        List<Integer> list = new ArrayList<>();\r\n        for (Integer i : ad1) {\r\n            list.add(i);\r\n        }\r\n        assertThat(list).containsExactly(7, 6, 5, 4, 3, 2, 1, 0);\r\n    }\r\n}\r\n","new_content_size":579,"new_hash":"d294fce6da3c8d8d7f437fed8186e93f24500ab5d5433143b8f90c00897da2cd","old_hash":"2525d1e7557127358b7826d721449667c094dec41ed7dd929531ad4a49f4869f","operation":"modify","path":"tests/ArrayDeque61BEnhancementTest.java"},"hash":"3e899a42c53f554fbf9bfd307278af6dff7cf2feb5ab8ecd45be3466e97220bc","kind":"fs.external_change","prev_hash":"f40f1f0b24b5d68b49279f37618f753f405bdb56e93a98be7968b363f8360ef1","seq":593,"t":24599191,"wall":"2026-10-14T14:23:37.549Z"}
