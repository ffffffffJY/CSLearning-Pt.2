{"data":{"diff_size":5,"new_content":"import org.junit.jupiter.api.Test;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\nimport static com.google.common.truth.Truth.assertThat;\r\n\r\npublic class ArrayDeque61BEnhancementTest {\r\n    @Test\r\n    public void testIterator() {\r\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\r\n        for (int i = 0; i < 8; i++) {\r\n            ad1.addFirst(i);\r\n        }\r\n        List<Integer> list = new ArrayList<>();\r\n        for (Integer i : ad1) {\r\n            list.add(i);\r\n        }\r\n        assertThat(list).containsExactly(7, 6, 5, 4, 3, 2, 1, 0);\r\n    }\r\n\r\n    @Test\r\n    public void testIterator2() {\r\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\r\n    }\r\n}\r\n","new_content_size":695,"new_hash":"7b6ef52e4cdd8b6a237091fbcb00b4a9558b210d7a08fc3efdde4fdf287e5b66","old_hash":"a7760da0ba72b59dfa0c07e06e880e53632765fee5e1416d509f7c4eb2325c20","operation":"modify","path":"tests/ArrayDeque61BEnhancementTest.java"},"hash":"64eefd475dcafaa0c12dfc4ecb0198f92f725b147175c1090c2fca94ab6c3108","kind":"fs.external_change","prev_hash":"71917a28b1126f0f8fbf14fad7e84904ff946641953fbd8ce460cb602dd98f15","seq":600,"t":24637435,"wall":"2026-10-14T14:24:15.793Z"}
