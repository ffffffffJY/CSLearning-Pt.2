{"data":{"content":"import java.util.List;\n\n/**\n * Created by hug on 2/4/2017. Methods are provided in the suggested order\n * that they should be completed.\n * Edited by Marcus Koh on 1/30/2026 to include getFirst and getLast\n */\npublic interface Deque61B<T> {\n\n    /**\n     * Add {@code x} to the front of the deque. Assumes {@code x} is never null.\n     *\n     * @param x item to add\n     */\n    void addFirst(T x);\n\n    /**\n     * Add {@code x} to the back of the deque. Assumes {@code x} is never null.\n     *\n     * @param x item to add\n     */\n    void addLast(T x);\n\n    /**\n     * Returns a List copy of the deque. Does not alter the deque.\n     *\n     * @return a new list copy of the deque.\n     */\n    List<T> toList();\n\n    /**\n     * Returns if the deque is empty. Does not alter the deque.\n     *\n     * @return {@code true} if the deque has no elements, {@code false} otherwise.\n     */\n    boolean isEmpty();\n\n    /**\n     * Returns the size of the deque. Does not alter the deque.\n     *\n     * @return the number of items in the deque.\n     */\n    int size();\n\n    /**\n     * Return the element at the front of the deque, if it exists.\n     *\n     * @return element, otherwise {@code null}.\n     */\n    T getFirst();\n\n    /**\n     * Return the element at the back of the deque, if it exists.\n     *\n     * @return element, otherwise {@code null}.\n     */\n    T getLast();\n\n    /**\n     * Remove and return the element at the front of the deque, if it exists.\n     *\n     * @return removed element, otherwise {@code null}.\n     */\n    T removeFirst();\n\n    /**\n     * Remove and return the element at the back of the deque, if it exists.\n     *\n     * @return removed element, otherwise {@code null}.\n     */\n    T removeLast();\n\n    /**\n     * The Deque61B abstract data type does not typically have a get method,\n     * but we've included this extra operation to provide you with some\n     * extra programming practice. Gets the element, iteratively. Returns\n     * null if index is out of bounds. Does not alter the deque.\n     *\n     * @param index index to get\n     * @return element at {@code index} in the deque\n     */\n    T get(int index);\n\n    /**\n     * This method technically shouldn't be in the interface, but it's here\n     * to make testing nice. Gets an element, recursively. Returns null if\n     * index is out of bounds. Does not alter the deque.\n     *\n     * @param index index to get\n     * @return element at {@code index} in the deque\n     */\n    T getRecursive(int index);\n}\n","line_count":94,"path":"src/Deque61B.java","sha256":"7499863c0c5f7b37aebef441c7d0f675f40589121d321e9f09a0858b67379693"},"hash":"953406e0d0a787fa36cf56921a5a18141c742dccfcda34728cc0bb6927b444db","kind":"doc.open","prev_hash":"ad791fdb55888cb4cf779a1a5e15144a9e560c6915a1fa4b55951922b4cc183a","seq":1,"t":208,"wall":"2026-10-14T07:33:38.566Z"}
{"data":{"content":"import java.util.ArrayList;\nimport java.util.List;\n\npublic class ArrayDeque61B<T> implements Deque61B<T>{\n\n    int size;\n    int start;\n    int end;\n    T[] array;\n\n    public ArrayDeque61B() {\n        this.size = 0;\n        this.start = 0;\n        this.end = 0;\n        this.array = (T[]) new Object[8];\n    }\n\n    private int circ(int x) {\n        if (x < 0) {\n            return x + array.length;\n        } else {\n            return x % array.length;\n        }\n    }\n\n    /**\n     * Add {@code x} to the front of the deque. Assumes {@code x} is never null.\n     *\n     * @param x item to add\n     */\n    @Override\n    public void addFirst(T x) {\n        size++;\n        if (size >= array.length) {\n            this.resizeUp();\n        }\n        start = circ(start - 1);\n        array[start] = x;\n    }\n\n    /**\n     * Add {@code x} to the back of the deque. Assumes {@code x} is never null.\n     *\n     * @param x item to add\n     */\n    @Override\n    public void addLast(T x) {\n        size++;\n        if (size >= array.length) {\n            this.resizeUp();\n        }\n        array[end] = x;\n        end = circ(end + 1);\n    }\n\n    /**\n     * Returns a List copy of the deque. Does not alter the deque.\n     *\n     * @return a new list copy of the deque.\n     */\n    @Override\n    public List<T> toList() {\n        List<T> returnList = new ArrayList<>();\n        for (int i = 0; i < size; i++) {\n            returnList.add(array[circ(i + start)]);\n        }\n        return returnList;\n    }\n\n    /**\n     * Returns if the deque is empty. Does not alter the deque.\n     *\n     * @return {@code true} if the deque has no elements, {@code false} otherwise.\n     */\n    @Override\n    public boolean isEmpty() {\n        if (size == 0) {\n            return true;\n        }\n        return false;\n    }\n\n    /**\n     * Returns the size of the deque. Does not alter the deque.\n     *\n     * @return the number of items in the deque.\n     */\n    @Override\n    public int size() {\n        return size;\n    }\n\n    /**\n     * Return the element at the front of the deque, if it exists.\n     *\n     * @return element, otherwise {@code null}.\n     */\n    @Override\n    public T getFirst() {\n        if (size == 0) {\n            return null;\n        }\n        return array[start];\n    }\n\n    /**\n     * Return the element at the back of the deque, if it exists.\n     *\n     * @return element, otherwise {@code null}.\n     */\n    @Override\n    public T getLast() {\n        if (size == 0) {\n            return null;\n        }\n        return array[circ(end - 1)];\n    }\n\n    /**\n     * Remove and return the element at the front of the deque, if it exists.\n     *\n     * @return removed element, otherwise {@code null}.\n     */\n    @Override\n    public T removeFirst() {\n        if (size == 0) {\n            return null;\n        }\n        size--;\n        if (size < array.length / 2 && array.length >= 16) {\n            this.resizeDown();\n        }\n        T ret = array[start];\n        start = circ(start + 1);\n        return ret;\n    }\n\n    /**\n     * Remove and return the element at the back of the deque, if it exists.\n     *\n     * @return removed element, otherwise {@code null}.\n     */\n    @Override\n    public T removeLast() {\n        if (size == 0) {\n            return null;\n        }\n        size--;\n        if (size < array.length / 2 && array.length >= 16) {\n            this.resizeDown();\n        }\n        end = circ(end - 1);\n        return array[end];\n    }\n\n    /**\n     * The Deque61B abstract data type does not typically have a get method,\n     * but we've included this extra operation to provide you with some\n     * extra programming practice. Gets the element, iteratively. Returns\n     * null if index is out of bounds. Does not alter the deque.\n     *\n     * @param index index to get\n     * @return element at {@code index} in the deque\n     */\n    @Override\n    public T get(int index) {\n        if (index < 0 || index >= size) {\n            return null;\n        }\n        return array[circ(index + start)];\n    }\n\n    /**\n     * This method technically shouldn't be in the interface, but it's here\n     * to make testing nice. Gets an element, recursively. Returns null if\n     * index is out of bounds. Does not alter the deque.\n     *\n     * @param index index to get\n     * @return element at {@code index} in the deque\n     */\n    @Override\n    public T getRecursive(int index) {\n        throw new UnsupportedOperationException(\"No need to implement getRecursive for ArrayDeque61B.\");\n    }\n\n    public void resizeUp() {\n        T[] copy = (T[]) new Object[2 * array.length];\n        for (int i = 0; i < size; i++) {\n            copy[i] = array[circ(i + start)];\n        }\n        start = 0;\n        end = size;\n        array = copy;\n    }\n\n    public void resizeDown() {\n        T[] copy = (T[]) new Object[array.length / 2];\n        for (int i = 0; i < size; i++) {\n            copy[i] = array[circ(i + start)];\n        }\n        start = 0;\n        end = size;\n        array = copy;\n    }\n}\n","line_count":206,"path":"src/ArrayDeque61B.java","sha256":"0600b29059cfb2bbf76c11fa8b5ce0c93fe58451b05706b784a52900eae8938e"},"hash":"c4899c7e52220ae848ec0a600368ad2ec93e5b4c38b2d1f767f5d46d7bbded38","kind":"doc.open","prev_hash":"953406e0d0a787fa36cf56921a5a18141c742dccfcda34728cc0bb6927b444db","seq":2,"t":208,"wall":"2026-10-14T07:33:38.566Z"}
{"data":{"content":"import org.junit.jupiter.api.DisplayName;\nimport org.junit.jupiter.api.Test;\n\nimport java.util.ArrayList;\nimport java.util.List;\n\nimport static com.google.common.truth.Truth.assertThat;\n\npublic class ArrayDeque61BTest {\n    @Test\n    /** In this test, we add three elements to verify that addFirst works correctly. */\n    public void addFirstTestBasic() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n\n        lld1.addFirst(\"back\"); // after this call we expect: [\"back\"]\n        lld1.addFirst(\"middle\"); // after this call we expect: [\"middle\", \"back\"]\n        lld1.addFirst(\"front\"); // after this call we expect: [\"front\", \"middle\", \"back\"]\n\n        assertThat(lld1.toList()).containsExactly(\"front\", \"middle\", \"back\").inOrder();\n    }\n\n    // Below, you'll write your own tests for LinkedListDeque61B.\n    @Test\n    public void addLastTestBasic() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        lld1.addLast(\"back\");\n        lld1.addLast(\"middle\");\n        lld1.addLast(\"front\");\n\n        assertThat(lld1.toList()).containsExactly(\"back\", \"middle\", \"front\").inOrder();\n    }\n\n    @Test\n    public void toListTestBasic() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        lld1.addFirst(\"back\");\n        lld1.addFirst(\"middle\");\n        lld1.addLast(\"front\");\n\n        List<String> lld = lld1.toList();\n        assertThat(lld).containsExactly(\"middle\", \"back\", \"front\").inOrder();\n    }\n\n    @Test\n    public void toListTestEmpty() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        List<String> lld = lld1.toList();\n        assertThat(lld).isEqualTo(new ArrayList<String>());\n    }\n\n    @Test\n    public void removeFirstTestBasic() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        lld1.addFirst(\"back\");\n        lld1.addFirst(\"middle\");\n        lld1.addFirst(\"front\");\n        String s = lld1.removeFirst();\n\n        assertThat(lld1.toList()).containsExactly(\"middle\", \"back\").inOrder();\n        assertThat(s).isEqualTo(\"front\");\n\n        s = lld1.removeFirst();\n        s = lld1.removeFirst();\n        s = lld1.removeFirst();\n\n        assertThat(s).isEqualTo(null);\n\n    }\n\n    @Test\n    public void isEmptyTest() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        assertThat(lld1.isEmpty()).isTrue();\n\n        lld1.addFirst(\"back\");\n        assertThat(lld1.isEmpty()).isFalse();\n\n        lld1.removeFirst();\n        assertThat(lld1.isEmpty()).isTrue();\n\n    }\n\n    @Test\n    public void removeLastTestBasic() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        lld1.addFirst(\"back\");\n        lld1.addFirst(\"middle\");\n        lld1.addFirst(\"front\");\n        String s = lld1.removeLast();\n\n        assertThat(lld1.toList()).containsExactly(\"front\", \"middle\").inOrder();\n        assertThat(s).isEqualTo(\"back\");\n\n        s = lld1.removeLast();\n        s = lld1.removeLast();\n        s = lld1.removeLast();\n\n        assertThat(s).isEqualTo(null);\n\n    }\n\n    @Test\n    public void sizeTest() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        lld1.addFirst(\"back\");\n        lld1.addFirst(\"middle\");\n        lld1.addFirst(\"front\");\n        assertThat(lld1.size()).isEqualTo(3);\n\n        String s = lld1.removeLast();\n        assertThat(lld1.size()).isEqualTo(2);\n\n        s = lld1.removeFirst();\n        assertThat(lld1.size()).isEqualTo(1);\n\n        s = lld1.removeLast();\n        s = lld1.removeLast();\n        assertThat(lld1.size()).isEqualTo(0);\n    }\n\n    @Test\n    public void getTest() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        lld1.addFirst(\"back\");\n        lld1.addFirst(\"middle\");\n        lld1.addFirst(\"front\");\n\n        assertThat(lld1.get(1)).isEqualTo(\"middle\");\n        assertThat(lld1.get(0)).isEqualTo(\"front\");\n        assertThat(lld1.get(3)).isNull();\n        assertThat(lld1.get(-10086)).isNull();\n\n    }\n\n    @Test\n    public void getFirstTest() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        assertThat(lld1.getFirst()).isNull();\n\n        lld1.addFirst(\"back\");\n        lld1.addLast(\"middle\");\n        assertThat(lld1.getFirst()).isEqualTo(\"back\");\n    }\n\n    @Test\n    public void getLastTest() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        assertThat(lld1.getLast()).isNull();\n\n        lld1.addFirst(\"back\");\n        lld1.addLast(\"middle\");\n        assertThat(lld1.getLast()).isEqualTo(\"middle\");\n    }\n\n    @Test\n    public void addAfterRemoveTest() {\n        Deque61B<Integer> lld1 = new ArrayDeque61B<>();\n        lld1.addFirst(1);\n        int x = lld1.removeLast();\n        lld1.addLast(4);\n        assertThat(lld1.toList()).containsExactly(4).inOrder();\n\n        x = lld1.removeFirst();\n        lld1.addFirst(x);\n        assertThat(lld1.toList()).containsExactly(4).inOrder();\n    }\n\n    @Test\n    public void resizeTest() {\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\n        ad1.addFirst(1);\n        ad1.addFirst(2);\n        ad1.resizeUp();\n        ad1.resizeDown();\n\n        assertThat(ad1.toList()).containsExactly(2, 1).inOrder();\n        assertThat(ad1.start).isEqualTo(0);\n\n    }\n\n    @Test\n    public void addAndRemoveAfterResizingTest() {\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\n        for (int i = 0; i < 10; i++) {\n            ad1.addFirst(i);\n        }\n        assertThat(ad1.toList()).containsExactly(9, 8, 7, 6, 5, 4, 3, 2, 1, 0).inOrder();\n        assertThat(ad1.size()).isEqualTo(10);\n\n        ad1.removeLast();\n        ad1.removeLast();\n        ad1.removeLast();\n        assertThat(ad1.size()).isEqualTo(7);\n\n    }\n}\n","line_count":197,"path":"tests/ArrayDeque61BTest.java","sha256":"fff795039884385dae7cac1ef8f108d16080629dbbbd9a1cda40bb1f5c8c7c5e"},"hash":"1c444c8d6e142e2b68dcfc20b28d065dc1bba245d6ec2044252ca9d5fc6c3002","kind":"doc.open","prev_hash":"c4899c7e52220ae848ec0a600368ad2ec93e5b4c38b2d1f767f5d46d7bbded38","seq":3,"t":208,"wall":"2026-10-14T07:33:38.566Z"}
