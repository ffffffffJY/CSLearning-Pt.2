{"data":{"diff_size":1,"new_content":"import org.apache.commons.collections.iterators.ArrayListIterator;\r\nimport org.jspecify.annotations.NonNull;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.Iterator;\r\nimport java.util.List;\r\n\r\npublic class ArrayDeque61B<T> implements Deque61B<T>{\r\n\r\n    int size;\r\n    int start;\r\n    int end;\r\n    T[] array;\r\n\r\n    public ArrayDeque61B() {\r\n        this.size = 0;\r\n        this.start = 0;\r\n        this.end = 0;\r\n        this.array = (T[]) new Object[8];\r\n    }\r\n\r\n    private int circ(int x) {\r\n        if (x < 0) {\r\n            return x + array.length;\r\n        } else {\r\n            return x % array.length;\r\n        }\r\n    }\r\n\r\n    /**\r\n     * Add {@code x} to the front of the deque. Assumes {@code x} is never null.\r\n     *\r\n     * @param x item to add\r\n     */\r\n    @Override\r\n    public void addFirst(T x) {\r\n        size++;\r\n        if (size >= array.length) {\r\n            this.resizeUp();\r\n        }\r\n        start = circ(start - 1);\r\n        array[start] = x;\r\n    }\r\n\r\n    /**\r\n     * Add {@code x} to the back of the deque. Assumes {@code x} is never null.\r\n     *\r\n     * @param x item to add\r\n     */\r\n    @Override\r\n    public void addLast(T x) {\r\n        size++;\r\n        if (size >= array.length) {\r\n            this.resizeUp();\r\n        }\r\n        array[end] = x;\r\n        end = circ(end + 1);\r\n    }\r\n\r\n    /**\r\n     * Returns a List copy of the deque. Does not alter the deque.\r\n     *\r\n     * @return a new list copy of the deque.\r\n     */\r\n    @Override\r\n    public List<T> toList() {\r\n        List<T> returnList = new ArrayList<>();\r\n        for (int i = 0; i < size; i++) {\r\n            returnList.add(array[circ(i + start)]);\r\n        }\r\n        return returnList;\r\n    }\r\n\r\n    /**\r\n     * Returns if the deque is empty. Does not alter the deque.\r\n     *\r\n     * @return {@code true} if the deque has no elements, {@code false} otherwise.\r\n     */\r\n    @Override\r\n    public boolean isEmpty() {\r\n        if (size == 0) {\r\n            return true;\r\n        }\r\n        return false;\r\n    }\r\n\r\n    /**\r\n     * Returns the size of the deque. Does not alter the deque.\r\n     *\r\n     * @return the number of items in the deque.\r\n     */\r\n    @Override\r\n    public int size() {\r\n        return size;\r\n    }\r\n\r\n    /**\r\n     * Return the element at the front of the deque, if it exists.\r\n     *\r\n     * @return element, otherwise {@code null}.\r\n     */\r\n    @Override\r\n    public T getFirst() {\r\n        if (size == 0) {\r\n            return null;\r\n        }\r\n        return array[start];\r\n    }\r\n\r\n    /**\r\n     * Return the element at the back of the deque, if it exists.\r\n     *\r\n     * @return element, otherwise {@code null}.\r\n     */\r\n    @Override\r\n    public T getLast() {\r\n        if (size == 0) {\r\n            return null;\r\n        }\r\n        return array[circ(end - 1)];\r\n    }\r\n\r\n    /**\r\n     * Remove and return the element at the front of the deque, if it exists.\r\n     *\r\n     * @return removed element, otherwise {@code null}.\r\n     */\r\n    @Override\r\n    public T removeFirst() {\r\n        if (size == 0) {\r\n            return null;\r\n        }\r\n        size--;\r\n        if (size < array.length / 2 && array.length >= 16) {\r\n            this.resizeDown();\r\n        }\r\n        T ret = array[start];\r\n        start = circ(start + 1);\r\n        return ret;\r\n    }\r\n\r\n    /**\r\n     * Remove and return the element at the back of the deque, if it exists.\r\n     *\r\n     * @return removed element, otherwise {@code null}.\r\n     */\r\n    @Override\r\n    public T removeLast() {\r\n        if (size == 0) {\r\n            return null;\r\n        }\r\n        size--;\r\n        if (size < array.length / 2 && array.length >= 16) {\r\n            this.resizeDown();\r\n        }\r\n        end = circ(end - 1);\r\n        return array[end];\r\n    }\r\n\r\n    /**\r\n     * The Deque61B abstract data type does not typically have a get method,\r\n     * but we've included this extra operation to provide you with some\r\n     * extra programming practice. Gets the element, iteratively. Returns\r\n     * null if index is out of bounds. Does not alter the deque.\r\n     *\r\n     * @param index index to get\r\n     * @return element at {@code index} in the deque\r\n     */\r\n    @Override\r\n    public T get(int index) {\r\n        if (index < 0 || index >= size) {\r\n            return null;\r\n        }\r\n        return array[circ(index + start)];\r\n    }\r\n\r\n    /**\r\n     * This method technically shouldn't be in the interface, but it's here\r\n     * to make testing nice. Gets an element, recursively. Returns null if\r\n     * index is out of bounds. Does not alter the deque.\r\n     *\r\n     * @param index index to get\r\n     * @return element at {@code index} in the deque\r\n     */\r\n    @Override\r\n    public T getRecursive(int index) {\r\n        throw new UnsupportedOperationException(\"No need to implement getRecursive for ArrayDeque61B.\");\r\n    }\r\n\r\n    public void resizeUp() {\r\n        T[] copy = (T[]) new Object[2 * array.length];\r\n        for (int i = 0; i < size; i++) {\r\n            copy[i] = array[circ(i + start)];\r\n        }\r\n        start = 0;\r\n        end = size;\r\n        array = copy;\r\n    }\r\n\r\n    public void resizeDown() {\r\n        T[] copy = (T[]) new Object[array.length / 2];\r\n        for (int i = 0; i < size; i++) {\r\n            copy[i] = array[circ(i + start)];\r\n        }\r\n        start = 0;\r\n        end = size;\r\n        array = copy;\r\n    }\r\n\r\n    /**\r\n     * Returns an iterator over elements of type {@code T}.\r\n     *\r\n     * @return an Iterator.\r\n     */\r\n    @Override\r\n    public @NonNull Iterator<T> iterator() {\r\n        return new ArrayDequeIterator();\r\n    }\r\n\r\n    private class ArrayDequeIterator implements Iterator<T> {\r\n        private int pos;\r\n\r\n        public ArrayDequeIterator() {\r\n            pos = 0;\r\n        }\r\n\r\n        @Override\r\n        public boolean hasNext() {\r\n            return pos < size;\r\n        }\r\n\r\n        @Override\r\n        public T next() {\r\n            T ret = array[pos];\r\n            pos = circ(pos + 1);\r\n            return ret;\r\n        }\r\n    }\r\n}\r\n","new_content_size":6011,"new_hash":"713142821bbdba9e2d35415f65d197c30c2d66d9f734b394f886eec1c5f7888e","old_hash":"a8db395f26acc9b8d0273c4e9cb67068d95c624ff541ec0ad280331e422958e0","operation":"modify","path":"src/ArrayDeque61B.java"},"hash":"e47c91f2de3de89556744798301f87ad3d338dda6333a0614bbb83a9bf1e2e69","kind":"fs.external_change","prev_hash":"646f5c8f12a7d7cbc15dbdbedcaa5b3c610b4e46f3f4489cfa7574b9300c4f3e","seq":535,"t":24452126,"wall":"2026-10-14T14:21:10.484Z"}
