{"data":{"diff_size":11,"new_content":"import org.junit.jupiter.api.Test;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\nimport static com.google.common.truth.Truth.assertThat;\r\n\r\npublic class ArrayDeque61BEnhancementTest {\r\n    @Test\r\n    public void testIterator() {\r\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\r\n        for (int i = 0; i < 8; i++) {\r\n            ad1.addFirst(i);\r\n        }\r\n        List<Integer> list = new ArrayList<>();\r\n        for (Integer i : ad1) {\r\n            list.add(i);\r\n        }\r\n        assertThat(list).containsExactly(7, 6, 5, 4, 3, 2, 1, 0);\r\n    }\r\n\r\n    @Test\r\n    public void testEquals() {\r\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\r\n        ArrayDeque61B<Integer> ad2 = new ArrayDeque61B<>();\r\n        for (int i = 0; i < 8; i++) {\r\n            ad1.addFirst(i);\r\n            ad2.addFirst(i);\r\n        }\r\n        assertThat(ad1.equals(ad2)).isTrue();\r\n    }\r\n\r\n    @Test\r\n    public void testToString() {\r\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\r\n        assertThat(ad1.toString()).isEqualTo(\"[]\");\r\n\r\n        for (int i = 0; i < 8; i++) {\r\n            ad1.addFirst(i);\r\n        }\r\n        assertThat(ad1.toString()).isEqualTo(\"[7, 6, 5, 4, 3, 2, 1, 0]\");\r\n    }\r\n}\r\n","new_content_size":1235,"new_hash":"6ab52e70f5e147d1e9097dbaa2ce93e973ab94f9a8530ed86e56d08ba7af0b0e","old_hash":"94a60455259621c8b8e646680f89f94a25311a1c09c23e4ea41c3bdecf2db3f7","operation":"modify","path":"tests/ArrayDeque61BEnhancementTest.java"},"hash":"df9ac108751bae63b2cf8e0f9c6aee3fbfc8d44aa5ff3f73d2160ff53941745f","kind":"fs.external_change","prev_hash":"9ca8304db17ac5c91cc14baec7d52b1ac7e860c5c97af809bcc704e4272badca","seq":439,"t":5039752,"wall":"2026-10-15T14:12:07.563Z"}
