{"data":{"diff_size":32,"new_content":"import org.junit.jupiter.api.Test;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\nimport static com.google.common.truth.Truth.assertThat;\r\n\r\npublic class ArrayDeque61BEnhancementTest {\r\n    @Test\r\n    public void testIterator() {\r\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\r\n        for (int i = 0; i < 8; i++) {\r\n            ad1.addFirst(i);\r\n        }\r\n        List<Integer> list = new ArrayList<>();\r\n        for (Integer i : ad1) {\r\n            list.add(i);\r\n        }\r\n        assertThat(list).containsExactly(7, 6, 5, 4, 3, 2, 1, 0);\r\n    }\r\n\r\n    @Test\r\n    public void testEquals() {\r\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\r\n        ArrayDeque61B<Integer> ad2 = new ArrayDeque61B<>();\r\n        for (int i = 0; i < 8; i++) {\r\n            ad1.addFirst(i);\r\n            ad2.addFirst(i);\r\n        }\r\n        assertThat(ad1.equals(ad2)).isTrue();\r\n    }\r\n}\r\n","new_content_size":910,"new_hash":"4af9932d34ed877f3167b3e2ae0858b1463122717a3f8f9aa100ba8002aacae2","old_hash":"da51c65e5c134b2eb51158d164b4bab61ff7d7ebb0d74428cf8ca51c168f547c","operation":"modify","path":"tests/ArrayDeque61BEnhancementTest.java"},"hash":"8e97f920d41f303e90ba15914f70e7cd4cad339f8c8b0752c761c2de16459c3f","kind":"fs.external_change","prev_hash":"a938cecbb264869c6807fe326e01c4fcba67a7924c8840df0c57b9413f0581c1","seq":371,"t":3817719,"wall":"2026-10-15T13:51:45.529Z"}
