{"data":{"diff_size":3,"new_content":"import org.junit.jupiter.api.Test;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\nimport static com.google.common.truth.Truth.assertThat;\r\n\r\npublic class ArrayDeque61BEnhancementTest {\r\n    @Test\r\n    public void testIterator() {\r\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\r\n        for (int i = 0; i < 8; i++) {\r\n            ad1.addFirst(i);\r\n        }\r\n        List<Integer> list = new ArrayList<>();\r\n        for (Integer i : ad1) {\r\n            list.add(i);\r\n        }\r\n        assertThat(list).containsExactly(7, 6, 5, 4, 3, 2, 1, 0);\r\n    }\r\n\r\n    @Test\r\n    public void testEquals() {\r\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\r\n        ArrayDeque61B<Integer> ad2 = new ArrayDeque61B<>();\r\n        for (int i = 0; i < 8; i++) {\r\n            ad1.addFirst(i);\r\n            ad2.addFirst(i);\r\n        }\r\n        assertThat(ad1.equals(ad2)).isTrue();\r\n\r\n        ad1.removeFirst();\r\n        assertThat(ad1.equals(ad2)).isFalse();\r\n    }\r\n\r\n    @Test\r\n    public void testToString() {\r\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\r\n        assertThat(ad1.toString()).isEqualTo(\"[]\");\r\n\r\n        for (int i = 0; i < 8; i++) {\r\n            ad1.addFirst(i);\r\n        }\r\n        assertThat(ad1.toString()).isEqualTo(\"[7, 6, 5, 4, 3, 2, 1, 0]\");\r\n    }\r\n}\r\n","new_content_size":1313,"new_hash":"9ea6cb1b4eb72413d3754fc64ab36fc6c641fbb33d6984a01734a249a4e7bc7a","old_hash":"e122526a5a6822da74d3edc3c30bdf36435b144ad8823df583fa9535e71c026c","operation":"modify","path":"tests/ArrayDeque61BEnhancementTest.java"},"hash":"86fe75a9dafe332155315e2e5ff745950b8857dc86a7fe244ed032f1337179fb","kind":"fs.external_change","prev_hash":"2cd13b3ef0ad1f0025162c789afd1c9c4beb7feeddd555cdb85fef48c21442c8","seq":528,"t":5825649,"wall":"2026-10-15T14:25:13.460Z"}
