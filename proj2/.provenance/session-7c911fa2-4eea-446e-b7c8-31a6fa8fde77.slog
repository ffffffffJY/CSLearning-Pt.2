{"data":{"content":"import java.util.List;\n\n/**\n * Created by hug on 2/4/2017. Methods are provided in the suggested order\n * that they should be completed.\n * Edited by Marcus Koh on 1/30/2026 to include getFirst and getLast\n */\npublic interface Deque61B<T> extends Iterable<T> {\n\n    /**\n     * Add {@code x} to the front of the deque. Assumes {@code x} is never null.\n     *\n     * @param x item to add\n     */\n    void addFirst(T x);\n\n    /**\n     * Add {@code x} to the back of the deque. Assumes {@code x} is never null.\n     *\n     * @param x item to add\n     */\n    void addLast(T x);\n\n    /**\n     * Returns a List copy of the deque. Does not alter the deque.\n     *\n     * @return a new list copy of the deque.\n     */\n    List<T> toList();\n\n    /**\n     * Returns if the deque is empty. Does not alter the deque.\n     *\n     * @return {@code true} if the deque has no elements, {@code false} otherwise.\n     */\n    boolean isEmpty();\n\n    /**\n     * Returns the size of the deque. Does not alter the deque.\n     *\n     * @return the number of items in the deque.\n     */\n    int size();\n\n    /**\n     * Return the element at the front of the deque, if it exists.\n     *\n     * @return element, otherwise {@code null}.\n     */\n    T getFirst();\n\n    /**\n     * Return the element at the back of the deque, if it exists.\n     *\n     * @return element, otherwise {@code null}.\n     */\n    T getLast();\n\n    /**\n     * Remove and return the element at the front of the deque, if it exists.\n     *\n     * @return removed element, otherwise {@code null}.\n     */\n    T removeFirst();\n\n    /**\n     * Remove and return the element at the back of the deque, if it exists.\n     *\n     * @return removed element, otherwise {@code null}.\n     */\n    T removeLast();\n\n    /**\n     * The Deque61B abstract data type does not typically have a get method,\n     * but we've included this extra operation to provide you with some\n     * extra programming practice. Gets the element, iteratively. Returns\n     * null if index is out of bounds. Does not alter the deque.\n     *\n     * @param index index to get\n     * @return element at {@code index} in the deque\n     */\n    T get(int index);\n\n    /**\n     * This method technically shouldn't be in the interface, but it's here\n     * to make testing nice. Gets an element, recursively. Returns null if\n     * index is out of bounds. Does not alter the deque.\n     *\n     * @param index index to get\n     * @return element at {@code index} in the deque\n     */\n    T getRecursive(int index);\n}\n","line_count":94,"path":"src/Deque61B.java","sha256":"7a96f6c49b3c3280cc3dd53c1290ddc761c8e9a59e04ace91c17454c8b780a44"},"hash":"25445d470c92a191edc3493630c75079001b458cfc231b6b5284e7b8a64479a3","kind":"doc.open","prev_hash":"626e6650af5225b934e697044b7a168c5350378b1c648971e020bda0b974c9c2","seq":1,"t":326,"wall":"2026-10-15T12:48:08.137Z"}
{"data":{"content":"import org.apache.commons.collections.iterators.ArrayListIterator;\nimport org.jspecify.annotations.NonNull;\n\nimport java.util.ArrayList;\nimport java.util.Iterator;\nimport java.util.List;\n\npublic class ArrayDeque61B<T> implements Deque61B<T>{\n\n    int size;\n    int start;\n    int end;\n    T[] array;\n\n    public ArrayDeque61B() {\n        this.size = 0;\n        this.start = 0;\n        this.end = 0;\n        this.array = (T[]) new Object[8];\n    }\n\n    private int circ(int x) {\n        if (x < 0) {\n            return x + array.length;\n        } else {\n            return x % array.length;\n        }\n    }\n\n    /**\n     * Add {@code x} to the front of the deque. Assumes {@code x} is never null.\n     *\n     * @param x item to add\n     */\n    @Override\n    public void addFirst(T x) {\n        size++;\n        if (size >= array.length) {\n            this.resizeUp();\n        }\n        start = circ(start - 1);\n        array[start] = x;\n    }\n\n    /**\n     * Add {@code x} to the back of the deque. Assumes {@code x} is never null.\n     *\n     * @param x item to add\n     */\n    @Override\n    public void addLast(T x) {\n        size++;\n        if (size >= array.length) {\n            this.resizeUp();\n        }\n        array[end] = x;\n        end = circ(end + 1);\n    }\n\n    /**\n     * Returns a List copy of the deque. Does not alter the deque.\n     *\n     * @return a new list copy of the deque.\n     */\n    @Override\n    public List<T> toList() {\n        List<T> returnList = new ArrayList<>();\n        for (int i = 0; i < size; i++) {\n            returnList.add(array[circ(i + start)]);\n        }\n        return returnList;\n    }\n\n    /**\n     * Returns if the deque is empty. Does not alter the deque.\n     *\n     * @return {@code true} if the deque has no elements, {@code false} otherwise.\n     */\n    @Override\n    public boolean isEmpty() {\n        if (size == 0) {\n            return true;\n        }\n        return false;\n    }\n\n    /**\n     * Returns the size of the deque. Does not alter the deque.\n     *\n     * @return the number of items in the deque.\n     */\n    @Override\n    public int size() {\n        return size;\n    }\n\n    /**\n     * Return the element at the front of the deque, if it exists.\n     *\n     * @return element, otherwise {@code null}.\n     */\n    @Override\n    public T getFirst() {\n        if (size == 0) {\n            return null;\n        }\n        return array[start];\n    }\n\n    /**\n     * Return the element at the back of the deque, if it exists.\n     *\n     * @return element, otherwise {@code null}.\n     */\n    @Override\n    public T getLast() {\n        if (size == 0) {\n            return null;\n        }\n        return array[circ(end - 1)];\n    }\n\n    /**\n     * Remove and return the element at the front of the deque, if it exists.\n     *\n     * @return removed element, otherwise {@code null}.\n     */\n    @Override\n    public T removeFirst() {\n        if (size == 0) {\n            return null;\n        }\n        size--;\n        if (size < array.length / 2 && array.length >= 16) {\n            this.resizeDown();\n        }\n        T ret = array[start];\n        start = circ(start + 1);\n        return ret;\n    }\n\n    /**\n     * Remove and return the element at the back of the deque, if it exists.\n     *\n     * @return removed element, otherwise {@code null}.\n     */\n    @Override\n    public T removeLast() {\n        if (size == 0) {\n            return null;\n        }\n        size--;\n        if (size < array.length / 2 && array.length >= 16) {\n            this.resizeDown();\n        }\n        end = circ(end - 1);\n        return array[end];\n    }\n\n    /**\n     * The Deque61B abstract data type does not typically have a get method,\n     * but we've included this extra operation to provide you with some\n     * extra programming practice. Gets the element, iteratively. Returns\n     * null if index is out of bounds. Does not alter the deque.\n     *\n     * @param index index to get\n     * @return element at {@code index} in the deque\n     */\n    @Override\n    public T get(int index) {\n        if (index < 0 || index >= size) {\n            return null;\n        }\n        return array[circ(index + start)];\n    }\n\n    /**\n     * This method technically shouldn't be in the interface, but it's here\n     * to make testing nice. Gets an element, recursively. Returns null if\n     * index is out of bounds. Does not alter the deque.\n     *\n     * @param index index to get\n     * @return element at {@code index} in the deque\n     */\n    @Override\n    public T getRecursive(int index) {\n        throw new UnsupportedOperationException(\"No need to implement getRecursive for ArrayDeque61B.\");\n    }\n\n    public void resizeUp() {\n        T[] copy = (T[]) new Object[2 * array.length];\n        for (int i = 0; i < size; i++) {\n            copy[i] = array[circ(i + start)];\n        }\n        start = 0;\n        end = size;\n        array = copy;\n    }\n\n    public void resizeDown() {\n        T[] copy = (T[]) new Object[array.length / 2];\n        for (int i = 0; i < size; i++) {\n            copy[i] = array[circ(i + start)];\n        }\n        start = 0;\n        end = size;\n        array = copy;\n    }\n\n    /**\n     * Returns an iterator over elements of type {@code T}.\n     *\n     * @return an Iterator.\n     */\n    @Override\n    public @NonNull Iterator<T> iterator() {\n        return new ArrayDequeIterator();\n    }\n\n    private class ArrayDequeIterator implements Iterator<T> {\n        private int pos;\n\n        public ArrayDequeIterator() {\n            pos = 0;\n        }\n\n        @Override\n        public boolean hasNext() {\n            return pos < size;\n        }\n\n        @Override\n        public T next() {\n            T ret = array[circ(pos + start)];\n            pos = pos + 1;\n            return ret;\n        }\n    }\n\n    @Override\n    public boolean equals(Object obj) {\n        return obj instanceof ArrayDeque61B && equals((ArrayDeque61B<?>) obj);\n    }\n\n}\n","line_count":246,"path":"src/ArrayDeque61B.java","sha256":"9f2bf6eab604118f99763ec13a52d75890751c1b5027299bda06b6e4a85b533c"},"hash":"1e7ad4a17ce6d7f48328d66f134be689a4c18473d21ec92d1be833b945e8731f","kind":"doc.open","prev_hash":"25445d470c92a191edc3493630c75079001b458cfc231b6b5284e7b8a64479a3","seq":2,"t":327,"wall":"2026-10-15T12:48:08.137Z"}
{"data":{"content":"import org.junit.jupiter.api.Test;\n\nimport java.util.ArrayList;\nimport java.util.List;\n\nimport static com.google.common.truth.Truth.assertThat;\n\npublic class ArrayDeque61BEnhancementTest {\n    @Test\n    public void testIterator() {\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\n        for (int i = 0; i < 8; i++) {\n            ad1.addFirst(i);\n        }\n        List<Integer> list = new ArrayList<>();\n        for (Integer i : ad1) {\n            list.add(i);\n        }\n        assertThat(list).containsExactly(7, 6, 5, 4, 3, 2, 1, 0);\n    }\n\n    @Test\n    public void testIterator2() {\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\n    }\n}\n","line_count":27,"path":"tests/ArrayDeque61BEnhancementTest.java","sha256":"e69aee3df4a33eb7a970d95d889c7b253ee5af2a5ada1bc95ecc0a4ccee0600a"},"hash":"700ecd1cd139bd72902a2a6a11d0af437a2ce54e7ce8b08ac67cf4633c961aba","kind":"doc.open","prev_hash":"1e7ad4a17ce6d7f48328d66f134be689a4c18473d21ec92d1be833b945e8731f","seq":3,"t":328,"wall":"2026-10-15T12:48:08.137Z"}
{"data":{"content":"import org.junit.jupiter.api.DisplayName;\nimport org.junit.jupiter.api.Test;\n\nimport java.util.ArrayList;\nimport java.util.List;\n\nimport static com.google.common.truth.Truth.assertThat;\n\npublic class ArrayDeque61BTest {\n    @Test\n    /** In this test, we add three elements to verify that addFirst works correctly. */\n    public void addFirstTestBasic() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n\n        lld1.addFirst(\"back\"); // after this call we expect: [\"back\"]\n        lld1.addFirst(\"middle\"); // after this call we expect: [\"middle\", \"back\"]\n        lld1.addFirst(\"front\"); // after this call we expect: [\"front\", \"middle\", \"back\"]\n\n        assertThat(lld1.toList()).containsExactly(\"front\", \"middle\", \"back\").inOrder();\n    }\n\n    // Below, you'll write your own tests for LinkedListDeque61B.\n    @Test\n    public void addLastTestBasic() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        lld1.addLast(\"back\");\n        lld1.addLast(\"middle\");\n        lld1.addLast(\"front\");\n\n        assertThat(lld1.toList()).containsExactly(\"back\", \"middle\", \"front\").inOrder();\n    }\n\n    @Test\n    public void toListTestBasic() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        lld1.addFirst(\"back\");\n        lld1.addFirst(\"middle\");\n        lld1.addLast(\"front\");\n\n        List<String> lld = lld1.toList();\n        assertThat(lld).containsExactly(\"middle\", \"back\", \"front\").inOrder();\n    }\n\n    @Test\n    public void toListTestEmpty() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        List<String> lld = lld1.toList();\n        assertThat(lld).isEqualTo(new ArrayList<String>());\n    }\n\n    @Test\n    public void removeFirstTestBasic() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        lld1.addFirst(\"back\");\n        lld1.addFirst(\"middle\");\n        lld1.addFirst(\"front\");\n        String s = lld1.removeFirst();\n\n        assertThat(lld1.toList()).containsExactly(\"middle\", \"back\").inOrder();\n        assertThat(s).isEqualTo(\"front\");\n\n        s = lld1.removeFirst();\n        s = lld1.removeFirst();\n        s = lld1.removeFirst();\n\n        assertThat(s).isEqualTo(null);\n\n    }\n\n    @Test\n    public void isEmptyTest() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        assertThat(lld1.isEmpty()).isTrue();\n\n        lld1.addFirst(\"back\");\n        assertThat(lld1.isEmpty()).isFalse();\n\n        lld1.removeFirst();\n        assertThat(lld1.isEmpty()).isTrue();\n\n    }\n\n    @Test\n    public void removeLastTestBasic() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        lld1.addFirst(\"back\");\n        lld1.addFirst(\"middle\");\n        lld1.addFirst(\"front\");\n        String s = lld1.removeLast();\n\n        assertThat(lld1.toList()).containsExactly(\"front\", \"middle\").inOrder();\n        assertThat(s).isEqualTo(\"back\");\n\n        s = lld1.removeLast();\n        s = lld1.removeLast();\n        s = lld1.removeLast();\n\n        assertThat(s).isEqualTo(null);\n\n    }\n\n    @Test\n    public void sizeTest() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        lld1.addFirst(\"back\");\n        lld1.addFirst(\"middle\");\n        lld1.addFirst(\"front\");\n        assertThat(lld1.size()).isEqualTo(3);\n\n        String s = lld1.removeLast();\n        assertThat(lld1.size()).isEqualTo(2);\n\n        s = lld1.removeFirst();\n        assertThat(lld1.size()).isEqualTo(1);\n\n        s = lld1.removeLast();\n        s = lld1.removeLast();\n        assertThat(lld1.size()).isEqualTo(0);\n    }\n\n    @Test\n    public void getTest() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        lld1.addFirst(\"back\");\n        lld1.addFirst(\"middle\");\n        lld1.addFirst(\"front\");\n\n        assertThat(lld1.get(1)).isEqualTo(\"middle\");\n        assertThat(lld1.get(0)).isEqualTo(\"front\");\n        assertThat(lld1.get(3)).isNull();\n        assertThat(lld1.get(-10086)).isNull();\n\n    }\n\n    @Test\n    public void getFirstTest() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        assertThat(lld1.getFirst()).isNull();\n\n        lld1.addFirst(\"back\");\n        lld1.addLast(\"middle\");\n        assertThat(lld1.getFirst()).isEqualTo(\"back\");\n    }\n\n    @Test\n    public void getLastTest() {\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\n        assertThat(lld1.getLast()).isNull();\n\n        lld1.addFirst(\"back\");\n        lld1.addLast(\"middle\");\n        assertThat(lld1.getLast()).isEqualTo(\"middle\");\n    }\n\n    @Test\n    public void addAfterRemoveTest() {\n        Deque61B<Integer> lld1 = new ArrayDeque61B<>();\n        lld1.addFirst(1);\n        int x = lld1.removeLast();\n        lld1.addLast(4);\n        assertThat(lld1.toList()).containsExactly(4).inOrder();\n\n        x = lld1.removeFirst();\n        lld1.addFirst(x);\n        assertThat(lld1.toList()).containsExactly(4).inOrder();\n    }\n\n    @Test\n    public void resizeTest() {\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\n        ad1.addFirst(1);\n        ad1.addFirst(2);\n        ad1.resizeUp();\n        ad1.resizeDown();\n\n        assertThat(ad1.toList()).containsExactly(2, 1).inOrder();\n        assertThat(ad1.start).isEqualTo(0);\n\n    }\n\n    @Test\n    public void addAndRemoveAfterResizingTest() {\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\n        for (int i = 0; i < 10; i++) {\n            ad1.addFirst(i);\n        }\n        assertThat(ad1.toList()).containsExactly(9, 8, 7, 6, 5, 4, 3, 2, 1, 0).inOrder();\n        assertThat(ad1.size()).isEqualTo(10);\n\n        ad1.removeLast();\n        ad1.removeLast();\n        ad1.removeLast();\n        assertThat(ad1.size()).isEqualTo(7);\n\n    }\n}\n","line_count":197,"path":"tests/ArrayDeque61BTest.java","sha256":"fff795039884385dae7cac1ef8f108d16080629dbbbd9a1cda40bb1f5c8c7c5e"},"hash":"189ebd336244d758356d15c58445bd98d4a0b475da6ba15922323932d2c9e2e1","kind":"doc.open","prev_hash":"700ecd1cd139bd72902a2a6a11d0af437a2ce54e7ce8b08ac67cf4633c961aba","seq":4,"t":328,"wall":"2026-10-15T12:48:08.137Z"}
