{"data":{"diff_size":0,"new_content":"import org.junit.jupiter.api.DisplayName;\r\nimport org.junit.jupiter.api.Test;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\nimport static com.google.common.truth.Truth.assertThat;\r\n\r\npublic class ArrayDeque61BTest {\r\n    @Test\r\n    /** In this test, we add three elements to verify that addFirst works correctly. */\r\n    public void addFirstTestBasic() {\r\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\r\n\r\n        lld1.addFirst(\"back\"); // after this call we expect: [\"back\"]\r\n        lld1.addFirst(\"middle\"); // after this call we expect: [\"middle\", \"back\"]\r\n        lld1.addFirst(\"front\"); // after this call we expect: [\"front\", \"middle\", \"back\"]\r\n\r\n        assertThat(lld1.toList()).containsExactly(\"front\", \"middle\", \"back\").inOrder();\r\n    }\r\n\r\n    // Below, you'll write your own tests for LinkedListDeque61B.\r\n    @Test\r\n    public void addLastTestBasic() {\r\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\r\n        lld1.addLast(\"back\");\r\n        lld1.addLast(\"middle\");\r\n        lld1.addLast(\"front\");\r\n\r\n        assertThat(lld1.toList()).containsExactly(\"back\", \"middle\", \"front\").inOrder();\r\n    }\r\n\r\n    @Test\r\n    public void toListTestBasic() {\r\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\r\n        lld1.addFirst(\"back\");\r\n        lld1.addFirst(\"middle\");\r\n        lld1.addLast(\"front\");\r\n\r\n        List<String> lld = lld1.toList();\r\n        assertThat(lld).containsExactly(\"middle\", \"back\", \"front\").inOrder();\r\n    }\r\n\r\n    @Test\r\n    public void toListTestEmpty() {\r\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\r\n        List<String> lld = lld1.toList();\r\n        assertThat(lld).isEqualTo(new ArrayList<String>());\r\n    }\r\n\r\n    @Test\r\n    public void removeFirstTestBasic() {\r\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\r\n        lld1.addFirst(\"back\");\r\n        lld1.addFirst(\"middle\");\r\n        lld1.addFirst(\"front\");\r\n        String s = lld1.removeFirst();\r\n\r\n        assertThat(lld1.toList()).containsExactly(\"middle\", \"back\").inOrder();\r\n        assertThat(s).isEqualTo(\"front\");\r\n\r\n        s = lld1.removeFirst();\r\n        s = lld1.removeFirst();\r\n        s = lld1.removeFirst();\r\n\r\n        assertThat(s).isEqualTo(null);\r\n\r\n    }\r\n\r\n    @Test\r\n    public void isEmptyTest() {\r\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\r\n        assertThat(lld1.isEmpty()).isTrue();\r\n\r\n        lld1.addFirst(\"back\");\r\n        assertThat(lld1.isEmpty()).isFalse();\r\n\r\n        lld1.removeFirst();\r\n        assertThat(lld1.isEmpty()).isTrue();\r\n\r\n    }\r\n\r\n    @Test\r\n    public void removeLastTestBasic() {\r\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\r\n        lld1.addFirst(\"back\");\r\n        lld1.addFirst(\"middle\");\r\n        lld1.addFirst(\"front\");\r\n        String s = lld1.removeLast();\r\n\r\n        assertThat(lld1.toList()).containsExactly(\"front\", \"middle\").inOrder();\r\n        assertThat(s).isEqualTo(\"back\");\r\n\r\n        s = lld1.removeLast();\r\n        s = lld1.removeLast();\r\n        s = lld1.removeLast();\r\n\r\n        assertThat(s).isEqualTo(null);\r\n\r\n    }\r\n\r\n    @Test\r\n    public void sizeTest() {\r\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\r\n        lld1.addFirst(\"back\");\r\n        lld1.addFirst(\"middle\");\r\n        lld1.addFirst(\"front\");\r\n        assertThat(lld1.size()).isEqualTo(3);\r\n\r\n        String s = lld1.removeLast();\r\n        assertThat(lld1.size()).isEqualTo(2);\r\n\r\n        s = lld1.removeFirst();\r\n        assertThat(lld1.size()).isEqualTo(1);\r\n\r\n        s = lld1.removeLast();\r\n        s = lld1.removeLast();\r\n        assertThat(lld1.size()).isEqualTo(0);\r\n    }\r\n\r\n    @Test\r\n    public void getTest() {\r\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\r\n        lld1.addFirst(\"back\");\r\n        lld1.addFirst(\"middle\");\r\n        lld1.addFirst(\"front\");\r\n\r\n        assertThat(lld1.get(1)).isEqualTo(\"middle\");\r\n        assertThat(lld1.get(0)).isEqualTo(\"front\");\r\n        assertThat(lld1.get(3)).isNull();\r\n        assertThat(lld1.get(-10086)).isNull();\r\n\r\n    }\r\n\r\n    @Test\r\n    public void getFirstTest() {\r\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\r\n        assertThat(lld1.getFirst()).isNull();\r\n\r\n        lld1.addFirst(\"back\");\r\n        lld1.addLast(\"middle\");\r\n        assertThat(lld1.getFirst()).isEqualTo(\"back\");\r\n    }\r\n\r\n    @Test\r\n    public void getLastTest() {\r\n        Deque61B<String> lld1 = new ArrayDeque61B<>();\r\n        assertThat(lld1.getLast()).isNull();\r\n\r\n        lld1.addFirst(\"back\");\r\n        lld1.addLast(\"middle\");\r\n        assertThat(lld1.getLast()).isEqualTo(\"middle\");\r\n    }\r\n\r\n    @Test\r\n    public void addAfterRemoveTest() {\r\n        Deque61B<Integer> lld1 = new ArrayDeque61B<>();\r\n        lld1.addFirst(1);\r\n        int x = lld1.removeLast();\r\n        lld1.addLast(4);\r\n        assertThat(lld1.toList()).containsExactly(4).inOrder();\r\n\r\n        x = lld1.removeFirst();\r\n        lld1.addFirst(x);\r\n        assertThat(lld1.toList()).containsExactly(4).inOrder();\r\n    }\r\n\r\n    @Test\r\n    public void resizeTest() {\r\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\r\n        ad1.addFirst(1);\r\n        ad1.addFirst(2);\r\n        ad1.resizeUp();\r\n        ad1.resizeDown();\r\n\r\n        assertThat(ad1.toList()).containsExactly(2, 1).inOrder();\r\n        assertThat(ad1.start).isEqualTo(0);\r\n\r\n    }\r\n\r\n    @Test\r\n    public void addAndRemoveAfterResizingTest() {\r\n        ArrayDeque61B<Integer> ad1 = new ArrayDeque61B<>();\r\n        for (int i = 0; i < 10; i++) {\r\n            ad1.addFirst(i);\r\n        }\r\n        assertThat(ad1.toList()).containsExactly(9, 8, 7, 6, 5, 4, 3, 2, 1, 0).inOrder();\r\n        assertThat(ad1.size()).isEqualTo(10);\r\n\r\n        ad1.removeLast();\r\n        ad1.removeLast();\r\n        ad1.removeLast();\r\n        assertThat(ad1.size()).isEqualTo(7);\r\n\r\n    }\r\n}\r\n","new_content_size":5769,"new_hash":"506e00d528ad90966a8badec08fac322eaf11f52dc3bf459b45c9e97829246b1","old_hash":"1739530d7b0ae91d32d850ef23df560fe373aaece3fa0f0b3bc377b49cbac83a","operation":"modify","path":"tests/ArrayDeque61BTest.java"},"hash":"9fd886b95acb27c8a386118f62a3e2aa8b1ca6a1fabdf595d50f76313ab64516","kind":"fs.external_change","prev_hash":"4359fb72a49392ab0f3e0c1325cfd80deb53fc812b07477d5de4f7d4f9c2f703","seq":1371,"t":25093011,"wall":"2026-10-13T09:02:03.605Z"}
