{"data":{"diff_size":2,"new_content":"import edu.princeton.cs.algs4.StdRandom;\r\n\r\nimport java.awt.*;\r\nimport java.util.Map;\r\n\r\npublic class Particle {\r\n    public ParticleFlavor flavor;\r\n    public int lifespan;\r\n\r\n    public static final int PLANT_LIFESPAN = 150;\r\n    public static final int FLOWER_LIFESPAN = 75;\r\n    public static final int FIRE_LIFESPAN = 10;\r\n    public static final Map<ParticleFlavor, Integer> LIFESPANS =\r\n            Map.of(ParticleFlavor.FLOWER, FLOWER_LIFESPAN,\r\n                   ParticleFlavor.PLANT, PLANT_LIFESPAN,\r\n                   ParticleFlavor.FIRE, FIRE_LIFESPAN);\r\n\r\n    public Particle(ParticleFlavor flavor) {\r\n        this.flavor = flavor;\r\n        if (flavor == ParticleFlavor.FLOWER || flavor == ParticleFlavor.PLANT || flavor == ParticleFlavor.FIRE) {\r\n            ;\r\n        } else {\r\n            lifespan = -1;\r\n        }\r\n    }\r\n\r\n    public Color color() {\r\n        if (flavor == ParticleFlavor.EMPTY) {\r\n            return Color.BLACK;\r\n        } else if (flavor == ParticleFlavor.SAND) {\r\n            return Color.YELLOW;\r\n        } else if (flavor == ParticleFlavor.BARRIER) {\r\n            return Color.GRAY;\r\n        } else if (flavor == ParticleFlavor.WATER) {\r\n            return Color.BLUE;\r\n        } else if (flavor == ParticleFlavor.FOUNTAIN) {\r\n            return Color.CYAN;\r\n        } else if (flavor == ParticleFlavor.PLANT) {\r\n            return new Color(0, 255, 0);\r\n        } else if (flavor == ParticleFlavor.FIRE) {\r\n            return new Color(255, 0, 0);\r\n        } else {\r\n            return new Color(255, 141, 161);\r\n        }\r\n\r\n    }\r\n\r\n    public void moveInto(Particle other) {\r\n        other.lifespan = this.lifespan;\r\n        other.flavor = this.flavor;\r\n        this.flavor = ParticleFlavor.EMPTY;\r\n        this.lifespan = -1;\r\n    }\r\n\r\n    public void fall(Map<Direction, Particle> neighbors) {\r\n        Particle Below = neighbors.get(Direction.DOWN);\r\n        if (Below.flavor == ParticleFlavor.EMPTY) {\r\n            this.moveInto(Below);\r\n        }\r\n    }\r\n\r\n    public void flow(Map<Direction, Particle> neighbors) {\r\n        int behavior = StdRandom.uniformInt(3);\r\n        if (behavior == 0) {\r\n            Particle Left = neighbors.get(Direction.LEFT);\r\n            if (Left.flavor == ParticleFlavor.EMPTY) {\r\n                this.moveInto(Left);\r\n            }\r\n        } else if (behavior == 1) {\r\n            Particle Right = neighbors.get(Direction.RIGHT);\r\n            if (Right.flavor == ParticleFlavor.EMPTY) {\r\n                this.moveInto(Right);\r\n            }\r\n        } else {\r\n            return;\r\n        }\r\n    }\r\n\r\n    public void grow(Map<Direction, Particle> neighbors) {\r\n        int behavior = StdRandom.uniformInt(10);\r\n        if (behavior == 0) {\r\n            Particle Left = neighbors.get(Direction.LEFT);\r\n            if (Left.flavor == ParticleFlavor.EMPTY) {\r\n                Left.lifespan = this.lifespan;\r\n                Left.flavor = this.flavor;\r\n            }\r\n        } else if (behavior == 1) {\r\n            Particle Right = neighbors.get(Direction.RIGHT);\r\n            if (Right.flavor == ParticleFlavor.EMPTY) {\r\n                Right.lifespan = this.lifespan;\r\n                Right.flavor = this.flavor;\r\n            }\r\n        } else if (behavior == 2) {\r\n            Particle Up = neighbors.get(Direction.UP);\r\n            if (Up.flavor == ParticleFlavor.EMPTY) {\r\n                Up.lifespan = this.lifespan;\r\n                Up.flavor = this.flavor;\r\n            }\r\n        } else {\r\n            return;\r\n        }\r\n    }\r\n\r\n    public void burn(Map<Direction, Particle> neighbors) {\r\n    }\r\n\r\n    public void action(Map<Direction, Particle> neighbors) {\r\n        if (this.flavor == ParticleFlavor.EMPTY) {\r\n            return;\r\n        }\r\n        if (this.flavor != ParticleFlavor.BARRIER) {\r\n            this.fall(neighbors);\r\n        }\r\n        if (this.flavor == ParticleFlavor.WATER) {\r\n            this.flow(neighbors);\r\n        }\r\n        if (this.flavor == ParticleFlavor.PLANT ||  this.flavor == ParticleFlavor.FLOWER) {\r\n            this.grow(neighbors);\r\n        }\r\n    }\r\n\r\n    public void decrementLifespan(){\r\n        if (this.lifespan == 0) {\r\n            \r\n        }\r\n    }\r\n}","new_content_size":4190,"new_hash":"9ca88b1b0bf2fb0174ed7558b3e90f21bf5f0f5344a3ac2c786d7d96684650dd","old_hash":"7beb3334e4276b23ec8a50f131ebd7185079fbcaa8ce6677af018b21009bc962","operation":"modify","path":"src/Particle.java"},"hash":"f15712276a77ec5efe163e47b9202f79d5dc05f4f1b3db69294368baf372fbf1","kind":"fs.external_change","prev_hash":"bc540c6ed6bd00620249ac5007f9d1cbd4f464eb8721fa491d0ef0a704b77760","seq":1788,"t":4136368,"wall":"2026-09-21T09:09:25.016Z"}
