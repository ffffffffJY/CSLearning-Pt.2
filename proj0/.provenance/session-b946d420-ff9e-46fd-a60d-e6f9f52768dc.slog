{"data":{"content":"public enum ParticleFlavor {\n    SAND,\n    BARRIER,\n    WATER,\n    PLANT,\n    FIRE,\n    EMPTY,\n    FOUNTAIN,\n    FLOWER\n}\n","line_count":11,"path":"src/ParticleFlavor.java","sha256":"f6cca33e6942e68b58a1010ad3d9c7f7683516cf7f781e868fc9e28b0ccd9c78"},"hash":"7bb82979bf907210be2b75fb5f8c3eb86f86df869c10d9b06d14ee09bff56cc4","kind":"doc.open","prev_hash":"e187553ddd8f11b03a4a6dd148b705016da8faabc656c6063c90ec6e06a36bf6","seq":7,"t":45069,"wall":"2026-10-22T08:10:13.912Z"}
