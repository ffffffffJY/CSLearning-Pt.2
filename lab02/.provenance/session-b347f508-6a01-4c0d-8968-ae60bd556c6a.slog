{"data":{"diff_size":64,"new_content":"package syntaxexercises;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\n/*\r\n * Exercise 2: Lists.\r\n *\r\n * Reminder of how common Python list operations look in Java:\r\n *\r\n *     Java                                   Python\r\n *     List<String> lst = new ArrayList<>();  lst = []\r\n *     lst.add(\"zero\");                       lst.append(\"zero\")\r\n *     lst.set(0, \"zed\");                     lst[0] = \"zed\"\r\n *     lst.get(0)                             lst[0]\r\n *     lst.size()                             len(lst)\r\n *     lst.contains(\"one\")                    \"one\" in lst\r\n *     for (String elem : lst) { ... }        for elem in lst: ...\r\n */\r\npublic class ListExercises {\r\n\r\n    /*\r\n     * (a) Translate the Python function below into Java.\r\n     *\r\n     *     def evens(L):\r\n     *         result = []\r\n     *         for x in L:\r\n     *             if x % 2 == 0:\r\n     *                 result.append(x)\r\n     *         return result\r\n     *\r\n     *     evens([3, 4, 7, 10])  # [4, 10]\r\n     */\r\n    /** Returns a new list containing the even integers of L, in order. */\r\n    public static List<Integer> evens(List<Integer> L) {\r\n        // TODO\r\n        List<Integer> ans = new ArrayList<>();\r\n        for (int x : L) {\r\n            if (x % 2 == 0) {\r\n                ans.add(x);\r\n            }\r\n        }\r\n        return ans;\r\n    }\r\n\r\n    /*\r\n     * (b) Translate the Python function below into Java.\r\n     *\r\n     *     def double_all(L):\r\n     *         for i in range(len(L)):\r\n     *             L[i] = L[i] * 2\r\n     *\r\n     *     L = [1, 2, 3]\r\n     *     double_all(L)\r\n     *     L  # [2, 4, 6]\r\n     */\r\n    /** Doubles every integer in L, in place. */\r\n    public static void doubleAll(List<Integer> L) {\r\n        // TODO\r\n        for (int x = 0; x < L.size(); x++) {\r\n            L.set(x, L.get(x) * 2);\r\n        }\r\n    }\r\n}\r\n","new_content_size":1863,"new_hash":"56fa657054a7d12d81ad349b0faa17367252c9b253631b944c9db883f3e5bf22","old_hash":"4a326fe61aea5961626e77d159c292c900bc28f358116af1efaec78cba84f0eb","operation":"modify","path":"src/syntaxexercises/ListExercises.java"},"hash":"1eaba2b47ce6b54e686a6072abfad3f39c98a2d5716cacc687f2830aaa0d1828","kind":"fs.external_change","prev_hash":"0631cd6bd58f6f694abf9356f50d73907ed8c24b6691f9f764be3339c8266892","seq":522,"t":926987,"wall":"2026-09-22T06:38:27.361Z"}
