{"data":{"content":"package demo;\n\nimport edu.princeton.cs.algs4.In;\n\nimport static main.Main.*;\n\npublic class FileReadDemo {\n    public static void main(String[] args) {\n        In in = new In(WORD_HISTORY_SIZE3_FILE);\n        int i = 0;\n\n        while (!in.isEmpty()) {\n            i += 1;\n            String nextLine = in.readLine();\n            System.out.print(\"Line \" + i + \" is: \");\n            System.out.println(nextLine);\n            System.out.print(\"After splitting on tab characters, the first word is: \");\n            String[] splitLine = nextLine.split(\"\\t\");\n            System.out.println(splitLine[0]);\n        }\n    }\n}\n","line_count":23,"path":"src/demo/FileReadDemo.java","sha256":"69ed25d6be6883c13b244b838c6b73cca3a2ae2b36a9a6abed17f033b739b44c"},"hash":"7c44b881886b12acdbc96b9d595a4b5eac93cd4fabe98f7c31996a5d648a9a2f","kind":"doc.open","prev_hash":"77a39fc3d6a0655b9c5c08622d5f922d918bc7e8237de0f3ebc8a79bcd853190","seq":966,"t":9896567,"wall":"2026-10-27T08:59:09.652Z"}
