{"data":{"diff_size":4,"new_content":"package main;\r\n\r\nimport browser.NgordnetQuery;\r\nimport browser.NgordnetQueryHandler;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\npublic class HistoryTextHandler extends NgordnetQueryHandler {\r\n    NGramMap wordMap;\r\n\r\n    HistoryTextHandler(NGramMap map){\r\n        wordMap = map;\r\n    }\r\n\r\n    @Override\r\n    public String handle(NgordnetQuery q) {\r\n        List<String> words = q.words();\r\n        int startYear = q.startYear();\r\n        int endYear = q.endYear();\r\n\r\n        List<String> response = new ArrayList<>();\r\n        int i = 0;\r\n        for(String word : words){\r\n            String responseWord = word;\r\n            responseWord += \": {\";\r\n            TimeSeries wordHistory = wordMap.weightHistory(word, startYear, endYear);\r\n            for (int j = startYear; j < endYear; j++) {\r\n                \r\n            }\r\n            response.add(responseWord);\r\n        }\r\n\r\n        return \"\";\r\n    }\r\n}\r\n","new_content_size":928,"new_hash":"a5ccfafe5c44b7f9bc575f4a403359c28bdcdffb35c298378248de8bbb99f961","old_hash":"8de8aa4baa50f00dff85f35b43aafe8145dd251b52c2e483ffe54c36c733bc0c","operation":"modify","path":"src/main/HistoryTextHandler.java"},"hash":"f80444d7b508dca82d7a9948d5b8c3df5a2335aae38b0a25460d95e2bfa69efe","kind":"fs.external_change","prev_hash":"612605ed4fa749eea3362cab3bfbcf2cdd35d3ff0087991d272287644a9d2a6d","seq":971,"t":1931906,"wall":"2026-11-04T07:16:45.479Z"}
