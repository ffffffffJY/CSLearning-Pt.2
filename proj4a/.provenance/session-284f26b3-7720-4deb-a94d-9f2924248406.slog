{"data":{"diff_size":8,"new_content":"package main;\r\n\r\nimport browser.NgordnetQuery;\r\nimport browser.NgordnetQueryHandler;\r\nimport browser.Plotter;\r\nimport org.knowm.xchart.XYChart;\r\n\r\nimport java.util.ArrayList;\r\n\r\npublic class HistoryHandler extends NgordnetQueryHandler {\r\n\r\n    NGramMap wordMap;\r\n\r\n    public HistoryHandler(NGramMap map) {\r\n        wordMap = map;\r\n    }\r\n\r\n    @Override\r\n    public String handle(NgordnetQuery q) {\r\n\r\n        ArrayList<TimeSeries> lts = new ArrayList<>();\r\n        ArrayList<String> labels = new ArrayList<>();\r\n\r\n        XYChart chart = Plotter.generateTimeSeriesChart(labels, lts);\r\n        String encodedImage = Plotter.encodeChartAsString(chart);\r\n\r\n        return encodedImage;\r\n    }\r\n}\r\n","new_content_size":696,"new_hash":"74c4164a7e341998fe9c20c8418636a35bc1f3d65c96a9e5afe5d1d355f9566d","old_hash":"9262a31c745103f1d6d1ca6a4b62230dc1f30b6f447b6c55e1a04c0c9f4be752","operation":"modify","path":"src/main/HistoryHandler.java"},"hash":"fe2a1bf9706db85cf0d2733a2b2951b24fd0c6f9a16bc2089211ed9240a01b4c","kind":"fs.external_change","prev_hash":"038a5e55fcd5292423afdf01daee81e94cc8cba65fc61b4dbe3d8ee431e6da77","seq":1738,"t":3085142,"wall":"2026-11-04T07:35:58.716Z"}
