{"data":{"content":"// This should say \"package main\" in your own HistoryTextHandler.java,\n// since your file will be in the \"main\" package.\npackage demo;\n\nimport browser.NgordnetQuery;\nimport browser.NgordnetQueryHandler;\n\nimport java.util.List;\n\npublic class DummyHistoryTextHandler extends NgordnetQueryHandler {\n    @Override\n    public String handle(NgordnetQuery q) {\n        List<String> words = q.words();\n        int startYear = q.startYear();\n        int endYear = q.endYear();\n\n        String response = \"You entered the following info into the browser:\\n\";\n        response += \"Words: \" + q.words() + \"\\n\";\n        response += \"Start Year: \" + q.startYear() + \"\\n\";\n        response += \"End Year: \" + q.endYear() + \"\\n\";\n        return response;\n    }\n}\n","line_count":24,"path":"src/demo/DummyHistoryTextHandler.java","sha256":"abbcb140f4e6278632753768d15ab283aa0bf983227073d16910d3b13cc4ceb7"},"hash":"35074ee711b4e7e9385dc76ef83705b053117c4dc2abe9820dae76b279dd81d5","kind":"doc.open","prev_hash":"4147461064f52bf68a6300a7c0c0473aba66d0a8af62bf884bca9f1e978230ba","seq":20,"t":314314,"wall":"2026-11-04T06:49:47.887Z"}
