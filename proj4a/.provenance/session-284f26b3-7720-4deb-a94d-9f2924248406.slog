{"data":{"diff_size":8,"new_content":"package main;\r\n\r\nimport browser.NgordnetQuery;\r\nimport browser.NgordnetQueryHandler;\r\nimport browser.Plotter;\r\nimport org.knowm.xchart.XYChart;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\npublic class HistoryHandler extends NgordnetQueryHandler {\r\n\r\n    NGramMap wordMap;\r\n\r\n    public HistoryHandler(NGramMap map) {\r\n        wordMap = map;\r\n    }\r\n\r\n    @Override\r\n    public String handle(NgordnetQuery q) {\r\n        ArrayList<TimeSeries> lts = new ArrayList<>();\r\n        ArrayList<String> labels = new ArrayList<>();\r\n        List<String> words = q.words();\r\n        int startYear = q.startYear();\r\n        int endYear = q.endYear();\r\n\r\n        for (String word : words) {\r\n            labels.add(word);\r\n            lts.add(wordMap.countHistory(word, startYear, endYear));\r\n        }\r\n\r\n        XYChart chart = Plotter.generateTimeSeriesChart(labels, lts);\r\n        String encodedImage = Plotter.encodeChartAsString(chart);\r\n\r\n        return encodedImage;\r\n    }\r\n}\r\n","new_content_size":986,"new_hash":"114c625da4dd0bf32467c76487b538a8efb5871e3b00140a8408a59b510b7de1","old_hash":"400594c9ff16f82b9ca8b0a7b7051c9cda4baaca3994a0d2abf664dd80be8d13","operation":"modify","path":"src/main/HistoryHandler.java"},"hash":"269a2733173c09eac0f21173141066daad2b366dad5c7972baf1b2f74b40ea9c","kind":"fs.external_change","prev_hash":"9f946ac31275ae6645e8196800318a628a211fcdccd1b29ce9fa96d8e2b27d00","seq":1870,"t":3279552,"wall":"2026-11-04T07:39:13.126Z"}
