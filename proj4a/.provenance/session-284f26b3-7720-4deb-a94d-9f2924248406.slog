{"data":{"diff_size":4,"new_content":"package main;\r\n\r\nimport browser.NgordnetQuery;\r\nimport browser.NgordnetQueryHandler;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\npublic class HistoryTextHandler extends NgordnetQueryHandler {\r\n    NGramMap wordMap;\r\n\r\n    HistoryTextHandler(NGramMap map){\r\n        wordMap = map;\r\n    }\r\n\r\n    @Override\r\n    public String handle(NgordnetQuery q) {\r\n        List<String> words = q.words();\r\n        int startYear = q.startYear();\r\n        int endYear = q.endYear();\r\n\r\n        String response = \"\";\r\n        for(String word : words){\r\n            response += \": \";\r\n            TimeSeries wordHistory = wordMap.weightHistory(word, startYear, endYear);\r\n            response += wordHistory.toString();\r\n            response += \"\\n\";\r\n        }\r\n\r\n        return response;\r\n    }\r\n}\r\n","new_content_size":796,"new_hash":"176b1b46dc2e8403e9b0d0d6566723574cee90c3e06322136cb88d3aac27866e","old_hash":"62dcf99db58ce2435e4a4e61a393a2c5f60975faa67f54f7ca7d1cd4423059d7","operation":"modify","path":"src/main/HistoryTextHandler.java"},"hash":"8c041f479557089ee9fdf04a177c7b96e106f11aa945df441b1902d1ab5913f8","kind":"fs.external_change","prev_hash":"618a0469a1af352d73d67d597af589b4e80c8b3d9dcbb4e1cecc49ac41fe5265","seq":1206,"t":2058059,"wall":"2026-11-04T07:18:51.632Z"}
