{"data":{"diff_size":0,"new_content":"package main;\r\n\r\nimport browser.NgordnetQuery;\r\nimport browser.NgordnetQueryHandler;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\npublic class HistoryTextHandler extends NgordnetQueryHandler {\r\n\r\n    HistoryTextHandler(NGramMap map){\r\n\r\n    }\r\n\r\n    @Override\r\n    public String handle(NgordnetQuery q) {\r\n        List<String> words = q.words();\r\n        int startYear = q.startYear();\r\n        int endYear = q.endYear();\r\n\r\n        List<String> ret = new ArrayList<>();\r\n        int i = 0;\r\n        for(String word : words){\r\n            ret.add(word);\r\n            ret.get(0) += \r\n        }\r\n\r\n        return \"\";\r\n    }\r\n}\r\n","new_content_size":639,"new_hash":"fa23508ed0ee20e8284252f00c34a6b15ea5cd5d14a0e07820178840f9c74d9d","old_hash":"dae8a5fd06cbb5788caf12015bf60e55d4f82ceed2d3ffd201fec0c8ccb72817","operation":"modify","path":"src/main/HistoryTextHandler.java"},"hash":"0fa3bac8d32b93f3174b261e6258843b9d2c5130c3b17a186a0041e1d5c0e060","kind":"fs.external_change","prev_hash":"ef84a09274ab9bf7aa8e9eed5a1b61298005302c74d0517253cd17194cd08d8f","seq":506,"t":1489144,"wall":"2026-11-04T07:09:22.717Z"}
