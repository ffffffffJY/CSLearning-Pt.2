{"data":{"diff_size":6,"new_content":"package main;\r\n\r\nimport browser.NgordnetQuery;\r\nimport browser.NgordnetQueryHandler;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\npublic class HistoryTextHandler extends NgordnetQueryHandler {\r\n\r\n    HistoryTextHandler(NGramMap map){\r\n\r\n    }\r\n\r\n    @Override\r\n    public String handle(NgordnetQuery q) {\r\n        List<String> words = q.words();\r\n        int startYear = q.startYear();\r\n        int endYear = q.endYear();\r\n\r\n        List<String> ret = new ArrayList<>();\r\n        int i = 0;\r\n        for(String word : words){\r\n            ret.add(word);\r\n            \r\n        }\r\n\r\n        return \"\";\r\n    }\r\n}\r\n","new_content_size":625,"new_hash":"6b9d4ad834d8e70fe794932ec5111111311716ba8c3caf5087389450534add4e","old_hash":"c980e14a57b09d0286defb7dcb4e79ab5af39b9537b096364dc042807cae3dd4","operation":"modify","path":"src/main/HistoryTextHandler.java"},"hash":"412d6e34191a2ebff148c9d86b276509d012cf05ea3574cdc0de9ae0fb7ea3bc","kind":"fs.external_change","prev_hash":"72d11f8ebe0fa1c9c506e620a05407ed5ba7319f13daeee73d6f915e5d44b26d","seq":467,"t":1248801,"wall":"2026-11-04T07:05:22.375Z"}
