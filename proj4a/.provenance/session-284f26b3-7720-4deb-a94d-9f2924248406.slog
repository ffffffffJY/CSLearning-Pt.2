{"data":{"diff_size":0,"new_content":"package main;\r\n\r\nimport browser.NgordnetQuery;\r\nimport browser.NgordnetQueryHandler;\r\n\r\npublic class HistoryHandler extends NgordnetQueryHandler {\r\n\r\n    NGramMap wordMap;\r\n\r\n    public HistoryHandler(NGramMap map) {\r\n        wordMap = map;\r\n    }\r\n\r\n    @Override\r\n    public String handle(NgordnetQuery q) {\r\n\r\n\r\n\r\n        return \"\";\r\n    }\r\n}\r\n","new_content_size":347,"new_hash":"ec9d56139309a320fc47647b61bf0d0301311067ee947d3bdd335c8a2acfb65d","old_hash":"068d47c663bb9c455c1040e84c312259c8366c066a0d3109ae2731a9eb32d346","operation":"modify","path":"src/main/HistoryHandler.java"},"hash":"5e44e69ace44f420e9d94d2a06c201716dd91f9d75b3df698c98e257a5cfac6f","kind":"fs.external_change","prev_hash":"12e6b9fe10690c84f4c675d6ebb0c5e4212e295d7d34f32e470f061c74cc91e9","seq":1600,"t":2695370,"wall":"2026-11-04T07:29:28.943Z"}
