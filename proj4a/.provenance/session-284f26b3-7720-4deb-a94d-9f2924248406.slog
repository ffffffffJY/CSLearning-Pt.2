{"data":{"diff_size":2,"new_content":"package main;\r\n\r\nimport browser.NgordnetQuery;\r\nimport browser.NgordnetQueryHandler;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\npublic class HistoryTextHandler extends NgordnetQueryHandler {\r\n\r\n    HistoryTextHandler(NGramMap map){\r\n\r\n    }\r\n\r\n    @Override\r\n    public String handle(NgordnetQuery q) {\r\n        List<String> words = q.words();\r\n        int startYear = q.startYear();\r\n        int endYear = q.endYear();\r\n\r\n        List<String> response = new ArrayList<>();\r\n        int i = 0;\r\n        for(String word : words){\r\n            String responseWord = word;\r\n            responseWord += \": {\";\r\n            \r\n            response.add(responseWord);\r\n        }\r\n\r\n        return \"\";\r\n    }\r\n}\r\n","new_content_size":720,"new_hash":"77cbaf5cc775c4cdf3b10bb2fcc250d45c43cd916c896b5a1c964d4c5213c245","old_hash":"df8f8e7bb3970a1567c0d957cf6eeae177e17f0d36f0d41ab03331b6e51d7f5f","operation":"modify","path":"src/main/HistoryTextHandler.java"},"hash":"dd13db37bb831dfdfcf43cdd3a002655f1c7d2cc12ea7dda9d8743e6defc874d","kind":"fs.external_change","prev_hash":"fe87759a96b82622bac28893957e656822aaf2770394670fd9c6e821c3379c93","seq":730,"t":1631748,"wall":"2026-11-04T07:11:45.317Z"}
