{"data":{"diff_size":0,"new_content":"package main;\r\n\r\nimport browser.NgordnetQuery;\r\nimport browser.NgordnetQueryHandler;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\npublic class HistoryTextHandler extends NgordnetQueryHandler {\r\n    NGramMap wordMap;\r\n\r\n    public HistoryTextHandler(NGramMap map){\r\n        wordMap = map;\r\n    }\r\n\r\n    @Override\r\n    public String handle(NgordnetQuery q) {\r\n        List<String> words = q.words();\r\n        int startYear = q.startYear();\r\n        int endYear = q.endYear();\r\n\r\n        String response = \"\";\r\n        for(String word : words){\r\n            response += \": \";\r\n            TimeSeries wordHistory = wordMap.weightHistory(word, startYear, endYear);\r\n            response += wordHistory.toString();\r\n            response += \"\\n\";\r\n        }\r\n\r\n        return response;\r\n    }\r\n}\r\n","new_content_size":803,"new_hash":"0637b21ba2d820a281206c003bdca64bc04e92d18820058d4b7cf39c9771da92","old_hash":"cb4b098e830dfedeafb4bf3b2a3233acdd0c5da4bcf4bcff19d422a2cf874e9a","operation":"modify","path":"src/main/HistoryTextHandler.java"},"hash":"bff219bdee4b0b9b17851ba88214cf09c3d6221092e16295ffd303016bf464eb","kind":"fs.external_change","prev_hash":"893279415d19d33648ac008ba49d0ca679ae879d5b7ecf8c348502861b50ce8b","seq":1332,"t":2202868,"wall":"2026-11-04T07:21:16.441Z"}
