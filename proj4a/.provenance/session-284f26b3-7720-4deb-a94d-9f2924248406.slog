{"data":{"content":"package main;\n\nimport java.util.Collection;\nimport java.util.TreeMap;\nimport java.util.Map;\n\nimport static main.TimeSeries.MAX_YEAR;\nimport static main.TimeSeries.MIN_YEAR;\n\nimport edu.princeton.cs.algs4.In;\n\n/**\n * An object that provides utility methods for making queries on the\n * Google NGrams dataset (or a subset thereof).\n *\n * An NGramMap stores pertinent data from a \"words file\" and a \"counts\n * file\". It is not a map in the strict sense, but it does provide additional\n * functionality.\n *\n * @author Josh Hug\n */\npublic class NGramMap {\n\n    Map<String, TimeSeries> wordMap;\n    TimeSeries yearMap;\n\n    /**\n     * Constructs an NGramMap from WORDHISTORYFILENAME and YEARHISTORYFILENAME.\n     */\n    public NGramMap(String wordHistoryFilename, String yearHistoryFilename) {\n        In inWord = new In(wordHistoryFilename);\n        In inYear = new In(yearHistoryFilename);\n        wordMap = new TreeMap<String, TimeSeries>();\n        yearMap = new TimeSeries();\n\n        while (!inWord.isEmpty()) {\n            String[] splitLine = inWord.readLine().split(\"\\t\");\n            String word = splitLine[0];\n            int year = Integer.parseInt(splitLine[1]);\n            Double frequency = Double.parseDouble(splitLine[2]);\n            if (wordMap != null && !wordMap.containsKey(word)) {\n                wordMap.put(word, new TimeSeries());\n            }\n            wordMap.get(word).put(year, frequency);\n        }\n        while (!inYear.isEmpty()) {\n            String[] splitLine = inYear.readLine().split(\",\");\n            int year = Integer.parseInt(splitLine[0]);\n            Double total = Double.parseDouble(splitLine[1]);\n            yearMap.put(year, total);\n        }\n    }\n\n    /**\n     * Provides the history of WORD between STARTYEAR and ENDYEAR, inclusive of both ends. The\n     * returned TimeSeries should be a copy, not a link to this NGramMap's TimeSeries. In other\n     * words, changes made to the object returned by this function should not also affect the\n     * NGramMap. This is also known as a \"defensive copy\". If the word is not in the data files,\n     * returns an empty TimeSeries.\n     */\n    public TimeSeries countHistory(String word, int startYear, int endYear) {\n        TimeSeries ret = new TimeSeries();\n        if (wordMap.containsKey(word)) {\n            ret = new TimeSeries(wordMap.get(word), startYear, endYear);\n        }\n        return ret;\n    }\n\n    /**\n     * Provides the history of WORD. The returned TimeSeries should be a copy, not a link to this\n     * NGramMap's TimeSeries. In other words, changes made to the object returned by this function\n     * should not also affect the NGramMap. This is also known as a \"defensive copy\". If the word\n     * is not in the data files, returns an empty TimeSeries.\n     */\n    public TimeSeries countHistory(String word) {\n        TimeSeries ret = new TimeSeries();\n        if (wordMap.containsKey(word)) {\n            ret = new TimeSeries(wordMap.get(word), MIN_YEAR, MAX_YEAR);\n        }\n        return ret;\n    }\n\n    /**\n     * Returns a defensive copy of the total number of words recorded per year in all volumes.\n     */\n    public TimeSeries totalCountHistory() {\n        return new TimeSeries(this.yearMap, MIN_YEAR, MAX_YEAR);\n    }\n\n    /**\n     * Provides a TimeSeries containing the relative frequency per year of WORD between STARTYEAR\n     * and ENDYEAR, inclusive of both ends. If the word is not in the data files, returns an empty\n     * TimeSeries.\n     */\n    public TimeSeries weightHistory(String word, int startYear, int endYear) {\n        TimeSeries wordHistory = countHistory(word, startYear, endYear);\n        TimeSeries totalHistory = totalCountHistory();\n        return wordHistory.dividedBy(totalHistory);\n    }\n\n    /**\n     * Provides a TimeSeries containing the relative frequency per year of WORD compared to all\n     * words recorded in that year. If the word is not in the data files, returns an empty\n     * TimeSeries.\n     */\n    public TimeSeries weightHistory(String word) {\n        TimeSeries wordHistory = countHistory(word);\n        TimeSeries totalHistory = totalCountHistory();\n        return wordHistory.dividedBy(totalHistory);\n    }\n\n    /**\n     * Provides the summed relative frequency per year of all words in WORDS between STARTYEAR and\n     * ENDYEAR, inclusive of both ends. If a word does not exist in this time frame, ignore it\n     * rather than throwing an exception.\n     */\n    public TimeSeries summedWeightHistory(Collection<String> words,\n                                          int startYear, int endYear) {\n        TimeSeries add = new TimeSeries();\n        for (String word : words) {\n            add = add.plus(countHistory(word, startYear, endYear));\n        }\n        return add.dividedBy(totalCountHistory());\n    }\n\n    /**\n     * Returns the summed relative frequency per year of all words in WORDS. If a word does not\n     * exist in this time frame, ignore it rather than throwing an exception.\n     */\n    public TimeSeries summedWeightHistory(Collection<String> words) {\n        TimeSeries add = new TimeSeries();\n        for (String word : words) {\n            add = add.plus(countHistory(word));\n        }\n        return add.dividedBy(totalCountHistory());\n    }\n\n}\n","line_count":139,"path":"src/main/NGramMap.java","sha256":"6d620d52d18902bb4c30e7763a9bd38e9fff1e6f68a74791632f6159061d1143"},"hash":"131d7bb03d56beeb7eb98bd47d3f7fc75faa2bc674fce26aeb1049f903bb67b4","kind":"doc.open","prev_hash":"472db5112936520e73042b2c41014f834347b2c8a643e4b5ba608e0bff261295","seq":1,"t":353,"wall":"2026-11-04T06:44:33.926Z"}
{"data":{"content":"\n/*\nimport browser.NgordnetQuery;\nimport main.HistoryTextHandler;\nimport main.NGramMap;\n\nimport org.junit.jupiter.api.Test;\nimport java.util.List;\n\nimport static main.Main.*;\nimport static com.google.common.truth.Truth.assertThat;\n */\n\n// uncomment this test whenever you are ready!\npublic class HistoryTextHandlerTest {\n    /*\n    @Test\n    public void testHandle() {\n        NGramMap ngm = new NGramMap(WORD_HISTORY_SIZE3_FILE, YEAR_HISTORY_FILE);\n        HistoryTextHandler handler = new HistoryTextHandler(ngm);\n        NgordnetQuery query = new NgordnetQuery(List.of(\"request\", \"airport\"), 2006, 2007, 0);\n        String actual = handler.handle(query);\n        String expected = \"\"\"\n                request: {2006=2.44740192927834E-5, 2007=2.464488338318067E-5}\n                airport: {2007=6.2068176510855946E-6}\n                \"\"\";\n        assertThat(actual).isEqualTo(expected);\n    }\n    */\n}\n","line_count":31,"path":"tests/HistoryTextHandlerTest.java","sha256":"6ff539a1f446ad63af49e6fa31266d2a7d2ef6f9cb4941a5b81da842cef530e7"},"hash":"f23da3cdaa76d1d029f580d7edfd5318888d354ccca19af93be213d642ec4d6d","kind":"doc.open","prev_hash":"131d7bb03d56beeb7eb98bd47d3f7fc75faa2bc674fce26aeb1049f903bb67b4","seq":2,"t":354,"wall":"2026-11-04T06:44:33.927Z"}
