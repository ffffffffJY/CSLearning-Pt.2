{"data":{"diff_size":1,"new_content":"package main;\r\n\r\nimport browser.NgordnetQuery;\r\nimport browser.NgordnetQueryHandler;\r\n\r\nimport java.util.List;\r\n\r\npublic class HistoryTextHandler extends NgordnetQueryHandler {\r\n    NGramMap wordMap;\r\n\r\n    public HistoryTextHandler(NGramMap map) {\r\n        wordMap = map;\r\n    }\r\n\r\n    @Override\r\n    public String handle(NgordnetQuery q) {\r\n        List<String> words = q.words();\r\n        int startYear = q.startYear();\r\n        int endYear = q.endYear();\r\n\r\n        StringBuilder response = new StringBuilder();\r\n        for (String word : words) {\r\n            response.append(word);\r\n            response.append(\": \");\r\n            TimeSeries wordHistory = wordMap.weightHistory(word, startYear, endYear);\r\n            response.append(wordHistory.toString());\r\n            response.append(\"\\n\");\r\n        }\r\n\r\n        return response.toString();\r\n    }\r\n}\r\n","new_content_size":863,"new_hash":"78a407cf5e671dd2b02ef40b555c6c10b82d86eb515221b20321a7d6d7a17baf","old_hash":"5883f25f30cd6b451228bd9990245d60d7d49ed3effdfa076b73daa104baabe1","operation":"modify","path":"src/main/HistoryTextHandler.java"},"hash":"3e8063af85951dd409258955f16de7cbef228328220f909a2ddac95b53b84ced","kind":"fs.external_change","prev_hash":"3edb2f8c911ba2d096693fad3f3f5078647cbb5631ff78520428a54911799c73","seq":1602,"t":2695396,"wall":"2026-11-04T07:29:28.969Z"}
