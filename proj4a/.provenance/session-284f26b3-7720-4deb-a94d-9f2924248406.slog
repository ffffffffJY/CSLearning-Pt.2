{"data":{"diff_size":0,"new_content":"package main;\r\n\r\nimport browser.NgordnetQuery;\r\nimport browser.NgordnetQueryHandler;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.List;\r\n\r\npublic class HistoryTextHandler extends NgordnetQueryHandler {\r\n    NGramMap wordMap;\r\n\r\n    public HistoryTextHandler(NGramMap map){\r\n        wordMap = map;\r\n    }\r\n\r\n    @Override\r\n    public String handle(NgordnetQuery q) {\r\n        List<String> words = q.words();\r\n        int startYear = q.startYear();\r\n        int endYear = q.endYear();\r\n\r\n        StringBuilder response = new StringBuilder();\r\n        for(String word : words){\r\n            response.append(word);\r\n            response.append(\": \");\r\n            TimeSeries wordHistory = wordMap.weightHistory(word, startYear, endYear);\r\n            response.append(wordHistory.toString());\r\n            response.append(\"\\n\");\r\n        }\r\n\r\n        return response.toString();\r\n    }\r\n}\r\n","new_content_size":889,"new_hash":"e01bddfef758007fcdc98e6e2b2cee5f738dfa5bed2a183713cdda9a429742a5","old_hash":"53fce82411c179869dae90e6e033a6dbc59d25ad59b7c59a2135e01e757239e2","operation":"modify","path":"src/main/HistoryTextHandler.java"},"hash":"4679a5c669e6e2bf0c799bff820e7d2ce6f5107f54f50a6a38d8ed597713fc0e","kind":"fs.external_change","prev_hash":"5ecdb8975ae4d85ab1fa93b68998714f71d38a08b6c43e563c71ba472801e4b1","seq":1370,"t":2253715,"wall":"2026-11-04T07:22:07.288Z"}
