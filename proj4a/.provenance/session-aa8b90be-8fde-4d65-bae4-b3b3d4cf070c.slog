{"data":{"content":"List<Integer> expectedYears = new ArrayList<>();\n        expectedYears.add(1991);\n        expectedYears.add(1992);\n        expectedYears.add(1994);\n        expectedYears.add(1995);\n\n        assertThat(totalPopulation.years()).isEqualTo(expectedYears);\n\n        List<Double> expectedTotal = new ArrayList<>();\n        expectedTotal.add(0.0);\n        expectedTotal.add(100.0);\n        expectedTotal.add(600.0);\n        expectedTotal.add(500.0);\n\n        for (int i = 0; i < expectedTotal.size(); i += 1) {\n            assertThat(totalPopulation.data().get(i)).isWithin(1E-10).of(expectedTotal.get(i));\n        }","length":609,"path":"tests/TimeSeriesTest.java","range":{"end":{"character":8,"line":90},"start":{"character":8,"line":90}},"sha256":"7004cd88c13c6eb3d5729494b8045f03d04968f6838f05a21869d4788be4e256"},"hash":"b2c09ac9380d4af6ea5bfb3e5c9160f98509242303fe072ffa0c07121dcd0696","kind":"paste","prev_hash":"5739dc2fcb58f9313d32ddd9d89029ca7498d64bb4f6759eee4b295390864cec","seq":802,"t":2989605,"wall":"2026-10-26T08:01:46.533Z"}
