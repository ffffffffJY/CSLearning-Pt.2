Capacity;\r\n        for (K key : this) {\r\n            newBuckets[hash(key)].add(getNode(key));\r\n        }\r\n        buckets = newBuckets;\r\n    }\r\n\r\n    private Node getNode(K key) {\r\n        for (Node n : buckets[hash(key)]) {\r\n            if (n.key.equals(key)) {\r\n                return n;\r\n            }\r\n        }\r\n        return null;\r\n    }\r\n\r\n\r\n}\r\n","new_content_size":7805,"new_hash":"bc3bc351f7c9ac6f0833334eec7b2f1a360b1efb414d207617e1659989048cb6","old_hash":"66e2d09a651d4a5001dc545605e1f78fbb82bdff44c1a45b7c9d54ed29490b07","operation":"modify","path":"src/hashmap/MyHashMap.java"},"hash":"80a84dd2d3faeda9755ef3c3152da2818fb46e06f695052097009001cb94adeb","kind":"fs.external_change","prev_hash":"f76ba819ac4a954ba434ce00f241c4c057b0faa023ba5c4cd3fd70df00681739","seq":283,"t":2780480,"wall":"2026-11-26T13:57:26.567Z"}
