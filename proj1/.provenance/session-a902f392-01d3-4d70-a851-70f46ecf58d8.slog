{"data":{"content":"    @Test\n    public void removeFirstTestBasic() {\n        Deque61B<String> lld1 = new LinkedListDeque61B<>();\n        lld1.addFirst(\"back\");\n        lld1.addFirst(\"middle\");\n        lld1.addFirst(\"front\");\n        String s = lld1.removeFirst();\n\n        assertThat(lld1.toList()).containsExactly(\"middle\", \"back\").inOrder();\n        assertThat(s).isEqualTo(\"front\");\n\n        s = lld1.removeFirst();\n        s = lld1.removeFirst();\n        s = lld1.removeFirst();\n\n        assertThat(s).isEqualTo(null);\n\n    }","length":511,"path":"tests/LinkedListDeque61BTest.java","range":{"end":{"character":4,"line":86},"start":{"character":4,"line":86}},"sha256":"c089157a12f2bdc900b4c2a060d2293a91584cc144b3f5527d1dff059c7c7194"},"hash":"89188c954df33002368fb3267516f186387688fd0980c3002d2ba68e9f2dc561","kind":"paste","prev_hash":"395550f05857b980445d5b812591e42ffe18c5c65b928ec3eb5e2459a68fcda8","seq":1579,"t":20095985,"wall":"2026-10-08T08:58:52.885Z"}
