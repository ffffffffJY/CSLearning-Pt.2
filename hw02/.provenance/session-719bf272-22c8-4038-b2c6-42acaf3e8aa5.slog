{"data":{"diff_size":4,"new_content":"public class StarTriangle5 {\r\n    /**\r\n     * Prints a right-aligned triangle of stars ('*') with 5 lines.\r\n     * The first row contains 1 star, the second 2 stars, and so on.\r\n     */\r\n    public static void starTriangle5() {\r\n        // TODO: Fill in this function\r\n        IO.println(\"    *\");\r\n        IO.println(\"   **\");\r\n        IO.println(\"  ***\");\r\n        IO.println(\" ****\");\r\n        IO.println(\"*****\");\r\n    }\r\n\r\n    void main() {\r\n        starTriangle5();\r\n    }\r\n}\r\n","new_content_size":483,"new_hash":"1abbb274416df47fcb9e400bebe822193b5f1e527c47363c770823d530eda396","old_hash":"be751b6cf16090486724349e78cd203cb49c21bb0f4c246f0ae8bea6a31f488e","operation":"modify","path":"src/StarTriangle5.java"},"hash":"2f7fb0144d44a532235017cba55f6914f21a223957d1d2385b177b510381de4c","kind":"fs.external_change","prev_hash":"895204b625afba4339887332e27428f7ccee5a3545cbd2f246f8f179cabc2258","seq":170,"t":239887,"wall":"2026-09-18T14:07:53.056Z"}
