{"data":{"diff_size":0,"new_content":"public class PrintIndexed {\r\n    /**\r\n     * Prints each character of a given string followed by the reverse of its index.\r\n     * Example: printIndexed(\"hello\") -> h4e3l2l1o0\r\n     */\r\n    public static void printIndexed(String s) {\r\n        // TODO: Fill in this function\r\n        int len = s.length();\r\n        for (int i = 0; i < len; i++) {\r\n            System.out.print(s.charAt(i));\r\n            IO.print(len - i - 1);\r\n        }\r\n        IO.println(\"\");\r\n    }\r\n\r\n    void main() {\r\n        printIndexed(\"hello\");\r\n        printIndexed(\"cat\"); // should print c2a1t0\r\n    }\r\n}\r\n","new_content_size":586,"new_hash":"147be1d809960c7ffa79dade01c2b6427aa1f39e8942edcf094327dc5fa8cfe1","old_hash":"0150fbba704fa3d864983650e245aee70c44e2a9f7544cd3e66ab235054155f3","operation":"modify","path":"src/PrintIndexed.java"},"hash":"592197eef67fb5593b390e8dbb7190a79908056797b6af05e2806cbdd065e569","kind":"fs.external_change","prev_hash":"ad603468c83f3b6d0fd410a5bd3ae94b8b2a86a6eb4c2ce280b50e8c428a6971","seq":603,"t":1070578,"wall":"2026-09-18T14:21:43.746Z"}
