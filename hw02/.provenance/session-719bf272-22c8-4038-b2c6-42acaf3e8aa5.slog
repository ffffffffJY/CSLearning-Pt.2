{"data":{"diff_size":23,"new_content":"public class DoubleUp {\r\n    /**\r\n     * Returns a new string where each character of the given string is repeated twice.\r\n     * Example: doubleUp(\"hello\") -> \"hheelllloo\"\r\n     */\r\n    public static String doubleUp(String s) {\r\n        // TODO: Fill in this function\r\n        String result = \"\";\r\n        for (int i = 0; i < s.length(); i++) {\r\n            result += s.charAt(i);\r\n            result += s.charAt(i);\r\n        }\r\n        return result;\r\n        return null;\r\n    }\r\n\r\n    void main() {\r\n        String s = doubleUp(\"hello\");\r\n        IO.println(s);\r\n\r\n        IO.println(doubleUp(\"cat\"));\r\n    }\r\n}\r\n","new_content_size":617,"new_hash":"7e3b3be6219f4042f7cf976c72371cfb905a6b4a32073d57aa342c98fc541a59","old_hash":"223617d106f0e0f25ed7fb77a556449c45502b117270adaa0ffd4d79d73184d8","operation":"modify","path":"src/DoubleUp.java"},"hash":"4c5036fd5aa47d8c3bf8882eb5b0efa90a25ef1bdbd155650314acd210d684d8","kind":"fs.external_change","prev_hash":"ddf3403bd535215c415bc19b3c74b727e502bfb2021924a8501fd895016fa522","seq":732,"t":1385818,"wall":"2026-09-18T14:26:58.987Z"}
